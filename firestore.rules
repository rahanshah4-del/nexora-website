allow update: if canManageWorkspace(workspaceId)&&safeUpdate(workspaceId)&&ownerMemberWriteSafe(workspaceId,memberId);
allow delete: if canManageWorkspace(workspaceId)&&!ownerMemberResource(workspaceId,memberId);
