rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isBlockedProfile() {
      return profileExists()
        && profile().status in ['blocked', 'disabled', 'inactive', 'Blocked', 'Disabled', 'Inactive'];
    }

    function activeSignedIn() {
      return signedIn() && !isBlockedProfile();
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActiveSelf(userId) {
      return activeSignedIn() && request.auth.uid == userId;
    }

    function isBackendAdmin() {
      return signedIn()
        && request.auth.token.email == 'rahanshah2@gmail.com';
    }

    function isBackendAdminEmail() {
      return isBackendAdmin();
    }

    function isAdmin() {
      return isBackendAdmin()
        || (activeSignedIn()
        && (
          profile().isAdmin == true
          || profile().role in ['platform_admin', 'super_admin', 'PLATFORM_ADMIN', 'SUPER_ADMIN']
        ));
    }

    function memberWorkspaceId() {
      return profile().workspaceId;
    }

    function memberRole() {
      return profile().role;
    }

    function workspaceDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isOwnerRole(role) {
      return role in ['owner', 'Owner', 'OWNER'];
    }

    function isAdminRole(role) {
      return role in ['admin', 'Admin', 'ADMIN'];
    }

    function isAccountantRole(role) {
      return role in ['accountant', 'Accountant', 'ACCOUNTANT'];
    }

    function isManagerRole(role) {
      return role in ['manager', 'Manager', 'MANAGER'];
    }

    function isSalesRole(role) {
      return role in ['sales', 'Sales', 'SALES', 'sales staff', 'Sales Staff', 'SALES STAFF'];
    }

    function permissionDocId() {
      return profile().staffId is string ? profile().staffId : request.auth.uid;
    }

    function profileWorkspaceMatches(workspaceId) {
      return profileExists()
        && (
          profile().workspaceId == workspaceId
          || profile().ownerId == workspaceId
          || profile().userId == workspaceId
        );
    }

    function workspaceOwnerMatches(workspaceId) {
      return activeSignedIn()
        && (
          request.auth.uid == workspaceId
          || (exists(/databases/$(database)/documents/workspaces/$(workspaceId))
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid)
          || (profileWorkspaceMatches(workspaceId) && isOwnerRole(memberRole()))
        );
    }

    function isWorkspaceMember(workspaceId) {
      return activeSignedIn()
        && (
          profileWorkspaceMatches(workspaceId)
          || workspaceOwnerMatches(workspaceId)
        );
    }

    function isBlockedWorkspaceMember(workspaceId) {
      return profileExists()
        && profileWorkspaceMatches(workspaceId)
        && profile().status in ['blocked', 'disabled', 'inactive', 'Blocked', 'Disabled', 'Inactive'];
    }

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function workspaceSubscriptionActive(workspaceId) {
      return workspaceExists(workspaceId)
        && (
          workspaceDoc(workspaceId).subscriptionStatus in ['active', 'paid', 'approved', 'current']
          || workspaceDoc(workspaceId).planStatus in ['active', 'paid', 'approved', 'current']
        )
        && (
          !workspaceDoc(workspaceId).keys().hasAny(['subscriptionExpiresAt'])
          || workspaceDoc(workspaceId).subscriptionExpiresAt >= request.time
        )
        && (
          !workspaceDoc(workspaceId).keys().hasAny(['expiresAt'])
          || workspaceDoc(workspaceId).expiresAt >= request.time
        )
        && (
          !workspaceDoc(workspaceId).keys().hasAny(['nextBillingDate'])
          || workspaceDoc(workspaceId).nextBillingDate >= request.time
        );
    }

    function workspaceTrialActive(workspaceId) {
      return workspaceExists(workspaceId)
        && (
          workspaceDoc(workspaceId).subscriptionStatus in ['trial', 'free trial']
          || workspaceDoc(workspaceId).planStatus in ['trial', 'free trial']
          || workspaceDoc(workspaceId).isTrialActive == true
        )
        && workspaceDoc(workspaceId).trialEndsAt >= request.time;
    }

    function workspaceHasWriteAccess(workspaceId) {
      return isAdmin() || workspaceSubscriptionActive(workspaceId) || workspaceTrialActive(workspaceId);
    }

    function ownsTargetWorkspace(workspaceId) {
      return activeSignedIn()
        && workspaceId is string
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && workspaceDoc(workspaceId).ownerId == request.auth.uid;
    }

    function roleHasPermission(role, key) {
      return isOwnerRole(role)
        || isAdminRole(role)
        || (isManagerRole(role)
          && key in ['followUpEdit', 'followUpDelete', 'customerManagement', 'leadsManagement', 'invoices', 'reports'])
        || (isSalesRole(role) && key in ['invoices'])
        || (isAccountantRole(role) && key in ['invoices', 'reports']);
    }

    function isWorkspaceManager(workspaceId) {
      return workspaceOwnerMatches(workspaceId)
        || isAdmin()
        || (isWorkspaceMember(workspaceId) && (isOwnerRole(memberRole()) || isAdminRole(memberRole())));
    }

    function isPaymentApprover(workspaceId) {
      return workspaceOwnerMatches(workspaceId)
        || isAdmin()
        || (isWorkspaceMember(workspaceId) && (isOwnerRole(memberRole()) || isAdminRole(memberRole()) || isAccountantRole(memberRole())));
    }

    function staffPermission(workspaceId, key) {
      return isWorkspaceManager(workspaceId)
        || isAdmin()
        || (isWorkspaceMember(workspaceId)
          && (
            roleHasPermission(memberRole(), key)
            || get(/databases/$(database)/documents/workspaces/$(workspaceId)/permissions/$(permissionDocId())).data[key] == true
          ));
    }

    function isOpenStatus(value) {
      return value in ['pending', 'pending_approval', 'pending_verification', 'pending_partial', 'partial_pending', 'partial', 'requested', 'invited'];
    }

    function isOpenApprovalResource() {
      return resource.data.requiresApproval == true
        || isOpenStatus(resource.data.approvalStatus)
        || isOpenStatus(resource.data.paymentStatus)
        || isOpenStatus(resource.data.status);
    }

    function workspaceCreateMetadata(workspaceId) {
      return request.resource.data.workspaceId == workspaceId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId);
    }

    function workspaceUpdateScopeSafe(workspaceId) {
      return (!request.resource.data.keys().hasAny(['workspaceId']) || request.resource.data.workspaceId == workspaceId)
        && (!resource.data.keys().hasAny(['workspaceId']) || request.resource.data.workspaceId == resource.data.workspaceId)
        && (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId)
        && (!resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == resource.data.ownerId);
    }

    function hasOwnScope(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.ownerId == userId
        && request.resource.data.workspaceId == userId;
    }

    function userIdentityScopeSafe(userId) {
      return (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == userId)
        && (!resource.data.keys().hasAny(['uid']) || request.resource.data.uid == resource.data.uid)
        && (!resource.data.keys().hasAny(['email']) || request.resource.data.email == resource.data.email)
        && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == userId)
        && (!resource.data.keys().hasAny(['userId']) || request.resource.data.userId == resource.data.userId)
        && (
          (resource.data.keys().hasAny(['workspaceId']) && request.resource.data.workspaceId == resource.data.workspaceId)
          || (resource.data.keys().hasAny(['workspaceId']) && ownsTargetWorkspace(request.resource.data.workspaceId))
          || (!resource.data.keys().hasAny(['workspaceId'])
            && (!request.resource.data.keys().hasAny(['workspaceId'])
              || request.resource.data.workspaceId == userId
              || ownsTargetWorkspace(request.resource.data.workspaceId)
              || (resource.data.ownerId is string && request.resource.data.workspaceId == resource.data.ownerId)))
        )
        && (
          (resource.data.keys().hasAny(['ownerId']) && request.resource.data.ownerId == resource.data.ownerId)
          || (resource.data.keys().hasAny(['ownerId']) && ownsTargetWorkspace(request.resource.data.workspaceId) && request.resource.data.ownerId == request.resource.data.workspaceId)
          || (!resource.data.keys().hasAny(['ownerId'])
            && (!request.resource.data.keys().hasAny(['ownerId'])
              || request.resource.data.ownerId == userId
              || (ownsTargetWorkspace(request.resource.data.workspaceId) && request.resource.data.ownerId == request.resource.data.workspaceId)
              || (resource.data.workspaceId is string && request.resource.data.ownerId == resource.data.workspaceId)))
        )
        && (
          (resource.data.keys().hasAny(['staffId']) && request.resource.data.staffId == resource.data.staffId)
          || (!resource.data.keys().hasAny(['staffId'])
            && (!request.resource.data.keys().hasAny(['staffId']) || request.resource.data.staffId == userId))
        );
    }

    function workspaceAccountScopeSafe(workspaceId) {
      return (!request.resource.data.keys().hasAny(['workspaceId']) || request.resource.data.workspaceId == workspaceId)
        && (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId)
        && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == workspaceId);
    }

    function hasSafeTrialPlan() {
      return (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan in ['Basic'])
        && (!request.resource.data.keys().hasAny(['planStatus']) || request.resource.data.planStatus in ['trial', 'Free Plan', 'Basic Trial', 'inactive'])
        && (!request.resource.data.keys().hasAny(['subscriptionStatus']) || request.resource.data.subscriptionStatus == 'trial')
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['owner', 'user'])
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['active', 'Active'])
        && (!request.resource.data.keys().hasAny(['trialDays']) || request.resource.data.trialDays == 7)
        && (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false);
    }

    function protectedAccountFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'planStatus',
        'subscriptionStatus',
        'billingCycle',
        'role',
        'isAdmin',
        'upgradedAt',
        'trialStartAt',
        'trialStartedAt',
        'trialEndsAt',
        'isTrialActive',
        'billingCurrency',
        'nextBillingDate',
        'subscriptionStartedAt',
        'subscriptionExpiresAt',
      ])
      && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'allowedBusinessTypes',
          'primaryBusinessType',
          'specialModuleAccess',
          'allModulesAccess',
        ])
        || (
          resource.data.onboardingCompleted != true
          && request.resource.data.specialModuleAccess == false
          && request.resource.data.allModulesAccess == false
          && request.resource.data.allowedBusinessTypes is list
          && request.resource.data.allowedBusinessTypes.size() == 1
          && request.resource.data.primaryBusinessType is string
          && request.resource.data.allowedBusinessTypes[0] == request.resource.data.primaryBusinessType
        )
      );
    }

    function planApprovalFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'plan',
        'planStatus',
        'subscriptionStatus',
        'billingCycle',
        'billingCurrency',
        'nextBillingDate',
        'expiresAt',
        'paidAt',
        'subscriptionStartedAt',
        'subscriptionExpiresAt',
        'isTrialActive',
        'upgradedAt',
        'updatedAt',
      ]);
    }

    function analyticsEventFieldsSafe() {
      return request.resource.data.keys().hasOnly([
        'eventType',
        'page',
        'buttonLabel',
        'moduleName',
        'userId',
        'email',
        'phone',
        'workspaceId',
        'businessType',
        'status',
        'sessionId',
        'visitorId',
        'referrer',
        'deviceType',
        'browser',
        'os',
        'country',
        'userAgent',
        'sessionDurationMs',
        'timestamp',
        'createdAt'
      ])
      && request.resource.data.eventType is string
      && request.resource.data.sessionId is string
      && request.resource.data.visitorId is string
      && request.resource.data.createdAt is timestamp;
    }

    function userSessionFieldsSafe() {
      return request.resource.data.keys().hasOnly([
        'sessionId',
        'visitorId',
        'userId',
        'email',
        'phone',
        'workspaceId',
        'businessType',
        'deviceType',
        'browser',
        'os',
        'userAgent',
        'startedAt',
        'lastActiveAt',
        'lastEventType',
        'sessionDurationMs'
      ])
      && request.resource.data.sessionId is string
      && request.resource.data.visitorId is string
      && request.resource.data.lastActiveAt is timestamp;
    }

    function paymentApprovalFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'paymentStatus',
        'approvalStatus',
        'status',
        'requiresApproval',
        'paidAt',
        'approvedBy',
        'approvedAt',
        'amountPaid',
        'partialPaidAmount',
        'balanceDue',
        'paymentHistory',
        'lastPaymentAt',
        'lastPaymentDate',
        'lastPaymentBy',
        'submittedForApprovalBy',
        'submittedForApprovalAt',
        'sentAt',
        'sentBy',
        'rejectedAt',
        'rejectedBy',
        'cancelledAt',
        'paidAt',
        'updatedAt',
        'ownerId',
        'userId',
        'workspaceId',
      ]);
    }

    function paymentReferenceFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'paymentStatus',
        'status',
        'paymentSubmittedAt',
        'paymentSubmittedBy',
        'lastPaymentReference',
        'ownerId',
        'userId',
        'workspaceId',
        'updatedAt',
      ])
      && request.resource.data.paymentStatus == 'pending_verification'
      && request.resource.data.paymentSubmittedBy == request.auth.uid;
    }

    function approvalStatusFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'approvalStatus',
        'approvedBy',
        'approvedAt',
        'paidAt',
        'rejectedBy',
        'rejectedAt',
        'ownerId',
        'userId',
        'workspaceId',
        'updatedAt',
      ]);
    }

    function upgradeApprovalFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'approvalStatus',
        'paymentStatus',
        'currency',
        'approvedBy',
        'approvedByEmail',
        'approvedAt',
        'rejectedBy',
        'rejectedByEmail',
        'rejectionReason',
        'rejectedAt',
        'updatedAt',
      ]);
    }

    function accountTransactionCreateScope(workspaceId) {
      return (request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId)
        && request.resource.data.userId == workspaceId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
    }

    function accountTransactionApprovalFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'approvalStatus',
        'requiresApproval',
        'approvedBy',
        'approvedAt',
        'rejectedBy',
        'rejectedAt',
        'ownerId',
        'userId',
        'workspaceId',
        'updatedAt',
      ]);
    }

    function canReadClientPortalInvoice(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && (
          resource.data.customerEmail == profile().email
          || resource.data.clientId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
          || isSelf(workspaceId)
        );
    }

    function canReadClientPortalPayment(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && (
          resource.data.submittedBy == request.auth.uid
          || resource.data.approvedBy == request.auth.uid
          || resource.data.clientId == request.auth.uid
          || isSelf(workspaceId)
        );
    }

    function canSubmitPaymentReference(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && request.resource.data.paymentStatus == 'pending_verification'
        && request.resource.data.submittedBy == request.auth.uid
        && (request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId)
        && request.resource.data.userId == workspaceId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
    }

    function isCreatingStaffUser(userId) {
      return activeSignedIn()
        && request.resource.data.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.workspaceId is string
        && request.resource.data.ownerId == request.resource.data.workspaceId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.role in ['staff', 'manager', 'admin', 'accountant']
        && isWorkspaceManager(request.resource.data.workspaceId);
    }

    function validSessionScope(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.workspaceId is string
        && (request.resource.data.ownerId == request.resource.data.workspaceId || request.resource.data.ownerId == workspaceDoc(request.resource.data.workspaceId).ownerId)
        && (
          request.resource.data.workspaceId == userId
          || (activeSignedIn() && memberWorkspaceId() == request.resource.data.workspaceId)
          || ownsTargetWorkspace(request.resource.data.workspaceId)
        );
    }

    match /users/{userId} {
      allow create: if isAdmin()
        || isCreatingStaffUser(userId)
        || (isActiveSelf(userId)
          && request.resource.data.uid == userId
          && hasOwnScope(userId)
          && request.resource.data.createdBy == userId
          && request.resource.data.createdAt is timestamp
          && hasSafeTrialPlan());
      allow read: if isSelf(userId) || isAdmin();
      allow update: if isAdmin()
        || (isActiveSelf(userId) && protectedAccountFieldsUnchanged() && userIdentityScopeSafe(userId))
        || (activeSignedIn()
          && resource.data.workspaceId is string
          && isAdmin()
          && planApprovalFieldsTouched());
      allow delete: if isAdmin();

      match /sessions/{sessionId} {
        allow create: if isActiveSelf(userId)
          && validSessionScope(userId)
          && request.resource.data.createdBy == userId
          && request.resource.data.createdAt is timestamp;
        allow read: if isSelf(userId) || isAdmin();
        allow update: if isAdmin()
          || (isActiveSelf(userId)
            && validSessionScope(userId)
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.ownerId == resource.data.ownerId);
        allow delete: if isAdmin();
      }
    }

    match /workspaces/{workspaceId} {
      allow create: if isAdmin()
        || (activeSignedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.userId == workspaceId
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && hasSafeTrialPlan());
      allow read: if isWorkspaceMember(workspaceId) || isAdmin();
      allow update: if isAdmin()
        || (workspaceOwnerMatches(workspaceId) && protectedAccountFieldsUnchanged() && workspaceAccountScopeSafe(workspaceId));
      allow delete: if isAdmin();

      match /tasks/{taskId} {
        allow read: if isWorkspaceMember(workspaceId) || isWorkspaceManager(workspaceId);
        allow create: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'followUpEdit') && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'followUpEdit') && workspaceUpdateScopeSafe(workspaceId);
        allow delete: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'followUpDelete');
      }

      match /staff/{staffId} {
        allow read: if isWorkspaceManager(workspaceId)
          || staffPermission(workspaceId, 'reports')
          || (isWorkspaceMember(workspaceId)
            && (resource.data.userId == request.auth.uid || resource.data.staffId == permissionDocId()));
        allow create: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceUpdateScopeSafe(workspaceId);
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /permissions/{staffId} {
        allow read: if isWorkspaceManager(workspaceId) || (isWorkspaceMember(workspaceId) && staffId == permissionDocId());
        allow create, update, delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /customers/{customerId} {
        allow read: if staffPermission(workspaceId, 'customerManagement') || staffPermission(workspaceId, 'reports');
        allow create: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'customerManagement') && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'customerManagement') && workspaceUpdateScopeSafe(workspaceId);
        allow delete: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'customerManagement');
      }

      match /clients/{clientId} {
        allow read: if isWorkspaceManager(workspaceId) || isPaymentApprover(workspaceId) || staffPermission(workspaceId, 'reports');
        allow create: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && (
          (isWorkspaceManager(workspaceId) && workspaceUpdateScopeSafe(workspaceId))
          || (isPaymentApprover(workspaceId) && approvalStatusFieldsTouched() && isOpenApprovalResource() && workspaceUpdateScopeSafe(workspaceId))
        );
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /products/{productId} {
        allow read: if staffPermission(workspaceId, 'invoices') || staffPermission(workspaceId, 'reports');
        allow create: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceUpdateScopeSafe(workspaceId);
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /leads/{leadId} {
        allow read: if staffPermission(workspaceId, 'leadsManagement') || staffPermission(workspaceId, 'reports');
        allow create: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'leadsManagement') && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'leadsManagement') && workspaceUpdateScopeSafe(workspaceId);
        allow delete: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'leadsManagement');
      }

      match /invoices/{invoiceId} {
        allow read: if staffPermission(workspaceId, 'invoices')
          || staffPermission(workspaceId, 'reports')
          || isPaymentApprover(workspaceId)
          || canReadClientPortalInvoice(workspaceId);
        allow create: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'invoices') && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && ((staffPermission(workspaceId, 'invoices') && !paymentApprovalFieldsTouched() && workspaceUpdateScopeSafe(workspaceId))
          || (isPaymentApprover(workspaceId) && paymentApprovalFieldsTouched() && workspaceUpdateScopeSafe(workspaceId))
          || (isWorkspaceMember(workspaceId) && paymentReferenceFieldsTouched() && isOpenApprovalResource() && workspaceUpdateScopeSafe(workspaceId)));
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /payments/{paymentId} {
        allow read: if staffPermission(workspaceId, 'invoices')
          || staffPermission(workspaceId, 'reports')
          || isPaymentApprover(workspaceId)
          || canReadClientPortalPayment(workspaceId);
        allow create: if workspaceHasWriteAccess(workspaceId) && ((isPaymentApprover(workspaceId) && workspaceCreateMetadata(workspaceId)) || canSubmitPaymentReference(workspaceId));
        allow update: if workspaceHasWriteAccess(workspaceId) && ((isWorkspaceManager(workspaceId) && !paymentApprovalFieldsTouched() && workspaceUpdateScopeSafe(workspaceId))
          || (isPaymentApprover(workspaceId) && paymentApprovalFieldsTouched() && isOpenApprovalResource() && workspaceUpdateScopeSafe(workspaceId)));
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /expenses/{expenseId} {
        allow read: if staffPermission(workspaceId, 'reports') || isPaymentApprover(workspaceId);
        allow create: if workspaceHasWriteAccess(workspaceId) && (isWorkspaceManager(workspaceId) || isPaymentApprover(workspaceId))
          && accountTransactionCreateScope(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && ((isWorkspaceManager(workspaceId) && !approvalStatusFieldsTouched() && workspaceUpdateScopeSafe(workspaceId))
          || (isPaymentApprover(workspaceId) && approvalStatusFieldsTouched() && isOpenApprovalResource() && workspaceUpdateScopeSafe(workspaceId)));
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /accountTransactions/{transactionId} {
        allow read: if staffPermission(workspaceId, 'reports') || isPaymentApprover(workspaceId);
        allow create: if workspaceHasWriteAccess(workspaceId) && isPaymentApprover(workspaceId) && accountTransactionCreateScope(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && ((isWorkspaceManager(workspaceId) && !accountTransactionApprovalFieldsTouched() && workspaceUpdateScopeSafe(workspaceId))
          || (isPaymentApprover(workspaceId) && accountTransactionApprovalFieldsTouched() && isOpenApprovalResource() && workspaceUpdateScopeSafe(workspaceId)));
        allow delete: if workspaceHasWriteAccess(workspaceId) && isActiveSelf(workspaceId);
      }

      match /pipelines/{dealId} {
        allow read: if staffPermission(workspaceId, 'reports') || staffPermission(workspaceId, 'leadsManagement');
        allow create: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'leadsManagement') && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'leadsManagement') && workspaceUpdateScopeSafe(workspaceId);
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /supportTickets/{ticketId} {
        allow read: if staffPermission(workspaceId, 'reports');
        allow create: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceUpdateScopeSafe(workspaceId);
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /subscriptions/{subscriptionId} {
        allow read: if staffPermission(workspaceId, 'reports');
        allow create: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceCreateMetadata(workspaceId);
        allow update, delete: if isAdmin();
      }

      match /activityLogs/{logId} {
        allow read: if staffPermission(workspaceId, 'reports');
        allow create: if workspaceHasWriteAccess(workspaceId)
          && (isActiveSelf(workspaceId) || isWorkspaceMember(workspaceId))
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.ownerId == workspaceId
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /teamMembers/{memberId} {
        allow read: if staffPermission(workspaceId, 'reports')
          || staffPermission(workspaceId, 'settingsAccess')
          || isPaymentApprover(workspaceId);
        allow create: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && ((isWorkspaceManager(workspaceId) && workspaceUpdateScopeSafe(workspaceId))
          || (isPaymentApprover(workspaceId) && approvalStatusFieldsTouched() && isOpenApprovalResource() && workspaceUpdateScopeSafe(workspaceId)));
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /branches/{branchId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceCreateMetadata(workspaceId);
        allow update: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId) && workspaceUpdateScopeSafe(workspaceId);
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /reports/{reportId} {
        allow read: if staffPermission(workspaceId, 'reports');
        allow create: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'reports') && workspaceCreateMetadata(workspaceId);
        allow update, delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /businessSettings/{businessTypeId} {
        allow read: if isAdmin() || isWorkspaceMember(workspaceId);
        allow create: if workspaceHasWriteAccess(workspaceId)
          && (isWorkspaceManager(workspaceId) || staffPermission(workspaceId, 'settingsAccess'))
          && request.resource.data.workspaceId == workspaceId;
        allow update: if workspaceHasWriteAccess(workspaceId)
          && (isWorkspaceManager(workspaceId) || staffPermission(workspaceId, 'settingsAccess'))
          && resource.data.workspaceId == workspaceId
          && request.resource.data.workspaceId == workspaceId;
        allow delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /hr/{employeeId} {
        allow read: if staffPermission(workspaceId, 'hrDashboard');
        allow write: if workspaceHasWriteAccess(workspaceId) && staffPermission(workspaceId, 'hrDashboard');
      }

      match /teamPermissions/{permissionId} {
        allow read: if staffPermission(workspaceId, 'settingsAccess') || isWorkspaceManager(workspaceId);
        allow create, update, delete: if workspaceHasWriteAccess(workspaceId) && isWorkspaceManager(workspaceId);
      }

      match /notifications/{notificationId} {
        allow create: if workspaceHasWriteAccess(workspaceId)
          && isWorkspaceMember(workspaceId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow read: if isAdmin()
          || (isWorkspaceMember(workspaceId) && resource.data.userId == request.auth.uid);
        allow update: if workspaceHasWriteAccess(workspaceId)
          && (isAdmin()
            || (isWorkspaceMember(workspaceId)
              && resource.data.userId == request.auth.uid
              && request.resource.data.userId == resource.data.userId
              && request.resource.data.workspaceId == workspaceId));
        allow delete: if workspaceHasWriteAccess(workspaceId)
          && (isAdmin() || (isWorkspaceMember(workspaceId) && resource.data.userId == request.auth.uid));
      }

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /upgradeRequests/{requestId} {
      allow create: if activeSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.workspaceId is string
        && request.resource.data.ownerId is string
        && isWorkspaceMember(request.resource.data.workspaceId)
        && request.resource.data.ownerId == workspaceDoc(request.resource.data.workspaceId).ownerId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.paymentStatus == 'pending';
      allow read: if isAdmin()
        || (activeSignedIn() && resource.data.userId == request.auth.uid)
        || (activeSignedIn()
          && resource.data.workspaceId is string
          && (isPaymentApprover(resource.data.workspaceId) || staffPermission(resource.data.workspaceId, 'reports')));
      allow update: if isAdmin()
        && upgradeApprovalFieldsTouched()
        && (
          isOpenStatus(resource.data.approvalStatus)
          || isOpenStatus(resource.data.paymentStatus)
        );
      allow delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    match /approvals/{approvalId} {
      allow read, write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /platformPayments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /platformSubscriptions/{subscriptionId} {
      allow read, write: if isAdmin();
    }

    match /backendActivityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read, write: if isAdmin();
    }

    match /clientSessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /userPresence/{presenceId} {
      allow read, write: if isAdmin();
    }

    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow create: if analyticsEventFieldsSafe();
      allow read, update, delete: if isBackendAdmin();
    }

    match /userSessions/{sessionId} {
      allow create, update: if userSessionFieldsSafe();
      allow read, delete: if isBackendAdmin();
    }

    match /plans/{planId} {
      allow read, write: if isAdmin();
    }

    match /platformPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /backendStaff/{staffId} {
      allow read, write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read, write: if isAdmin();
    }

    match /featureFlags/{flagId} {
      allow read, write: if isAdmin();
    }

    match /emailTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /{path=**}/subscriptions/{subscriptionId} {
      allow read, write: if isBackendAdmin();
    }

    match /{path=**}/payments/{paymentId} {
      allow read, write: if isBackendAdmin();
    }

    match /{path=**}/invoices/{invoiceId} {
      allow read, write: if isBackendAdmin();
    }

    match /{path=**}/approvals/{approvalId} {
      allow read, write: if isBackendAdmin();
    }

    match /{path=**}/activityLogs/{logId} {
      allow read, write: if isBackendAdmin();
    }

    match /{path=**}/supportTickets/{ticketId} {
      allow read, write: if isBackendAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if activeSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.workspaceId == memberWorkspaceId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin() || (activeSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (activeSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.workspaceId == resource.data.workspaceId);
      allow delete: if isAdmin() || (activeSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
