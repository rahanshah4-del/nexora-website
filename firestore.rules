rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function backendAdmin() {
      return signedIn()
        && request.auth.token.email in ['admin@nexora.com', 'rahanshah2@gmail.com'];
    }

    function marketingAdmin() {
      return backendAdmin()
        || (
          signedIn()
          && request.auth.token.email_verified != false
          && (
            request.auth.token.admin == true
            || request.auth.token.owner == true
            || request.auth.token.role in ['admin', 'Admin', 'ADMIN', 'owner', 'Owner', 'OWNER']
          )
        );
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userStatusActive() {
      // Safe field access — a missing `status` field would otherwise raise an
      // evaluation error that denies the request (see workspaceActive).
      return !hasUserDoc()
        || !(userDoc(request.auth.uid).get('status', 'active') in ['blocked', 'Blocked', 'BLOCKED', 'disabled', 'Disabled', 'DISABLED', 'inactive', 'Inactive', 'INACTIVE']);
    }

    function workspaceDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function workspaceActive(workspaceId) {
      // Use .get(field, default) — accessing a field that does not exist on the
      // document raises an evaluation error that DENIES the whole rule. Bootstrap
      // -created trial workspaces have no `accountStatus` (and may lack `status`),
      // which silently broke every workspace update + member-gated subcollection
      // write (the "could not create your first workspace" permission error).
      return workspaceExists(workspaceId)
        && !(workspaceDoc(workspaceId).get('status', 'active') in ['blocked', 'Blocked', 'BLOCKED', 'disabled', 'Disabled', 'DISABLED', 'inactive', 'Inactive', 'INACTIVE'])
        && !(workspaceDoc(workspaceId).get('accountStatus', 'active') in ['blocked', 'Blocked', 'BLOCKED', 'disabled', 'Disabled', 'DISABLED', 'inactive', 'Inactive', 'INACTIVE']);
    }

    function activeSignedIn() {
      return signedIn() && userStatusActive();
    }

    function isOwnerRole(role) {
      return role in ['owner', 'Owner', 'OWNER'];
    }

    function isAdminRole(role) {
      return role in ['admin', 'Admin', 'ADMIN'];
    }

    function isManagerRole(role) {
      return role in ['manager', 'Manager', 'MANAGER'];
    }

    function isSalesRole(role) {
      return role in ['sales', 'Sales', 'SALES', 'sales staff', 'Sales Staff', 'STAFF', 'staff', 'Staff'];
    }

    function isAccountantRole(role) {
      return role in ['accountant', 'Accountant', 'ACCOUNTANT'];
    }

    function profileWorkspaceMatches(workspaceId) {
      return hasUserDoc()
        && (
          request.auth.uid == workspaceId
          || userDoc(request.auth.uid).workspaceId == workspaceId
          || userDoc(request.auth.uid).ownerId == workspaceId
          || userDoc(request.auth.uid).companyId == workspaceId
          || userDoc(request.auth.uid).userId == workspaceId
          || (userDoc(request.auth.uid).workspaceIds is list && workspaceId in userDoc(request.auth.uid).workspaceIds)
          || (userDoc(request.auth.uid).workspaces is list && workspaceId in userDoc(request.auth.uid).workspaces)
        );
    }

    function workspaceOwner(workspaceId) {
      return activeSignedIn()
        && workspaceActive(workspaceId)
        && (
          request.auth.uid == workspaceId
          || workspaceDoc(workspaceId).ownerId == request.auth.uid
          || workspaceDoc(workspaceId).createdBy == request.auth.uid
          || workspaceDoc(workspaceId).userId == request.auth.uid
          || workspaceDoc(workspaceId).uid == request.auth.uid
          || (profileWorkspaceMatches(workspaceId) && isOwnerRole(userDoc(request.auth.uid).role))
        );
    }

    function workspaceAdmin(workspaceId) {
      return backendAdmin()
        || workspaceOwner(workspaceId)
        || (
          activeSignedIn()
          && workspaceActive(workspaceId)
          && profileWorkspaceMatches(workspaceId)
          && isAdminRole(userDoc(request.auth.uid).role)
        );
    }

    function workspaceMember(workspaceId) {
      return workspaceAdmin(workspaceId)
        || (
          activeSignedIn()
          && workspaceActive(workspaceId)
          && profileWorkspaceMatches(workspaceId)
        );
    }

    function memberRole() {
      return hasUserDoc() ? userDoc(request.auth.uid).role : '';
    }

    function permissionDocId() {
      return hasUserDoc() && userDoc(request.auth.uid).staffId is string
        ? userDoc(request.auth.uid).staffId
        : request.auth.uid;
    }

    function permissionDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/permissions/$(permissionDocId())).data;
    }

    function hasPermission(workspaceId, key) {
      return workspaceAdmin(workspaceId)
        || (
          workspaceMember(workspaceId)
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/permissions/$(permissionDocId()))
          && permissionDoc(workspaceId)[key] == true
        );
    }

    function canManageWorkspace(workspaceId) {
      return workspaceAdmin(workspaceId)
        || (workspaceMember(workspaceId) && isManagerRole(memberRole()));
    }

    function canWriteSales(workspaceId) {
      return workspaceAdmin(workspaceId)
        || (workspaceMember(workspaceId) && (isManagerRole(memberRole()) || isSalesRole(memberRole())))
        || hasPermission(workspaceId, 'leadsManagement')
        || hasPermission(workspaceId, 'customerManagement')
        || hasPermission(workspaceId, 'invoices');
    }

    function canWriteAccounting(workspaceId) {
      return workspaceAdmin(workspaceId)
        || (workspaceMember(workspaceId) && (isManagerRole(memberRole()) || isAccountantRole(memberRole())))
        || hasPermission(workspaceId, 'invoices')
        || hasPermission(workspaceId, 'reports');
    }

    function safeCreate(workspaceId) {
      return request.resource.data.workspaceId == workspaceId
        && request.resource.data.createdBy == request.auth.uid
        && (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId);
    }

    function safeUpdate(workspaceId) {
      return (!request.resource.data.keys().hasAny(['workspaceId']) || request.resource.data.workspaceId == workspaceId)
        && (!resource.data.keys().hasAny(['workspaceId']) || request.resource.data.workspaceId == resource.data.workspaceId)
        && (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId)
        && (!resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == resource.data.ownerId);
    }

    function protectedWorkspaceFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'planStatus',
        'subscriptionStatus',
        'billingCycle',
        'role',
        'isAdmin',
        'trialStartAt',
        'trialStartedAt',
        'trialEndsAt',
        'isTrialActive',
        'billingCurrency',
        'nextBillingDate',
        'subscriptionStartedAt',
        'subscriptionExpiresAt',
        'expiresAt'
      ]);
    }

    function ownerMemberTarget(workspaceId, memberId) {
      return memberId == workspaceId
        || memberId == workspaceDoc(workspaceId).ownerId
        || request.resource.data.uid == workspaceDoc(workspaceId).ownerId
        || request.resource.data.staffId == workspaceDoc(workspaceId).ownerId
        || isOwnerRole(request.resource.data.role);
    }

    function ownerMemberResource(workspaceId, memberId) {
      return memberId == workspaceId
        || memberId == workspaceDoc(workspaceId).ownerId
        || resource.data.uid == workspaceDoc(workspaceId).ownerId
        || resource.data.staffId == workspaceDoc(workspaceId).ownerId
        || isOwnerRole(resource.data.role);
    }

    function ownerMemberWriteSafe(workspaceId, memberId) {
      return (!ownerMemberTarget(workspaceId, memberId) || (isOwnerRole(request.resource.data.role) && !(request.resource.data.status in ['blocked', 'disabled', 'inactive', 'Blocked', 'Disabled', 'Inactive'])))
        && (!ownerMemberResource(workspaceId, memberId) || isOwnerRole(request.resource.data.role));
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if backendAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if backendAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'plan', 'planStatus', 'subscriptionStatus']));
      allow delete: if backendAdmin();

      match /{subPath=**} {
        allow read, write: if backendAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    match /phoneRegistry/{phoneId} {
      // Single-doc reads are public so the signup form can check phone
      // uniqueness BEFORE the user is authenticated. `get` only reveals whether
      // a phone you already know is taken; `list` (bulk enumeration) stays
      // admin-only to prevent harvesting the registry.
      allow get: if true;
      allow list: if backendAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if backendAdmin();
    }

    match /workspaces/{workspaceId} {
      allow create: if activeSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.createdBy == request.auth.uid;
      // The owner can always read their OWN workspace doc (workspaces/{uid}),
      // even if it doesn't exist yet (brand-new account, pre-onboarding) or is
      // blocked. This prevents a permission-denied read from being mistaken for
      // "account blocked", and lets the app read an explicit blocked status to
      // show the proper screen. Subcollections still require workspaceMember
      // (active), so a blocked workspace's DATA stays protected.
      allow read: if backendAdmin()
        || (signedIn() && request.auth.uid == workspaceId)
        || workspaceMember(workspaceId);
      allow update: if backendAdmin()
        || (workspaceAdmin(workspaceId) && protectedWorkspaceFieldsUnchanged());
      allow delete: if backendAdmin();

      match /permissions/{staffId} {
        allow read: if workspaceAdmin(workspaceId) || (workspaceMember(workspaceId) && staffId == permissionDocId());
        allow create, update, delete: if canManageWorkspace(workspaceId) && staffId != workspaceId && staffId != workspaceDoc(workspaceId).ownerId;
      }

      match /staff/{staffId} {
        allow read: if workspaceAdmin(workspaceId) || (workspaceMember(workspaceId) && staffId == permissionDocId());
        allow create, update: if canManageWorkspace(workspaceId) && safeUpdate(workspaceId) && ownerMemberWriteSafe(workspaceId, staffId);
        allow delete: if canManageWorkspace(workspaceId) && !ownerMemberResource(workspaceId, staffId);
      }

      match /teamMembers/{memberId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update: if canManageWorkspace(workspaceId) && safeUpdate(workspaceId) && ownerMemberWriteSafe(workspaceId, memberId);
        allow delete: if canManageWorkspace(workspaceId) && !ownerMemberResource(workspaceId, memberId);
      }

      match /teamPermissions/{permissionId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if canManageWorkspace(workspaceId);
      }

      match /businessSettings/{settingId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if workspaceAdmin(workspaceId) || hasPermission(workspaceId, 'settingsAccess');
      }

      match /whatsappSettings/{settingId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if workspaceAdmin(workspaceId) || hasPermission(workspaceId, 'settingsAccess');
      }

      match /customers/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /leads/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesDeals/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesTasks/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesActivities/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesQuotes/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesProducts/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesInvoices/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesExpenses/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /orders/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if workspaceMember(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /menuItems/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canManageWorkspace(workspaceId) && safeCreate(workspaceId);
        allow update: if canManageWorkspace(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /tables/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canManageWorkspace(workspaceId) && safeCreate(workspaceId);
        allow update: if workspaceMember(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /kot/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if workspaceMember(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /bills/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /restaurantSettings/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if workspaceAdmin(workspaceId) || hasPermission(workspaceId, 'settingsAccess');
      }

      match /reports/{docId} {
        allow read: if workspaceMember(workspaceId) || hasPermission(workspaceId, 'reports');
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update, delete: if canManageWorkspace(workspaceId);
      }

      match /invoices/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /payments/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /expenses/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /accountTransactions/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /activityLogs/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /notifications/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if workspaceMember(workspaceId);
      }

      match /supportTickets/{docId} {
        allow read: if backendAdmin() || workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if backendAdmin() || (workspaceMember(workspaceId) && safeUpdate(workspaceId));
        allow delete: if backendAdmin() || canManageWorkspace(workspaceId);
      }

      match /{collectionName}/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if workspaceMember(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }
    }

    match /upgradeRequests/{requestId} {
      allow create: if activeSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if backendAdmin() || (activeSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if backendAdmin();
    }

    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if backendAdmin();
    }

    match /platformPlans/{docId} {
      allow read: if true;
      allow write: if backendAdmin();
    }

    match /whatsappPricing/{docId} {
      allow read: if true;
      allow write: if backendAdmin();
    }

    match /platformPayments/{docId} {
      allow read, write: if backendAdmin();
    }

    match /platformSubscriptions/{docId} {
      allow read, write: if backendAdmin();
    }

    match /marketingSubscribers/{docId} {
      allow read, write: if marketingAdmin();
    }

    match /marketingCampaigns/{docId} {
      allow read, write: if marketingAdmin();
    }

    match /marketingEmailLogs/{docId} {
      allow read, write: if marketingAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if backendAdmin();
    }

    match /supportTickets/{docId} {
      allow create: if activeSignedIn();
      allow read, update, delete: if backendAdmin() || (activeSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /backendStaff/{docId} {
      allow read, write: if backendAdmin();
    }

    match /backendActivityLogs/{docId} {
      allow read, write: if backendAdmin();
    }

    match /analyticsEvents/{docId} {
      allow create: if true;
      allow read, update, delete: if backendAdmin();
    }

    match /userSessions/{docId} {
      allow create: if activeSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if backendAdmin() || (activeSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if backendAdmin();
    }
  }
}
