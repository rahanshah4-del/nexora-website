match /customers/{docId} {
allow read: if canReadModule(workspaceId,'customers')||canReadModule(workspaceId,'pos')||canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'transportCustomers');
allow create: if (canCreateModule(workspaceId,'customers')||canCreatePosSale(workspaceId)||canCreateModule(workspaceId,'transportCustomers'))&&safeCreate(workspaceId);
allow update: if (
  // Owner / admin / accountant — unrestricted field access
  (canEditModule(workspaceId,'customers')||canEditModule(workspaceId,'transportCustomers'))
  && safeUpdate(workspaceId)
) || (
  // Cashier via POS — restricted to wallet & purchase-tracking fields only
  canCreatePosSale(workspaceId)
  && safeUpdate(workspaceId)
  && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['walletCredit','walletDue','lifetimeSpend','posOrdersCount','lastPosOrderAt','updatedAt','workspaceId','ownerId'])
);
allow delete: if canDeleteModule(workspaceId,'customers');
}
match /customers/{customerId}/walletTransactions/{docId} {
allow read: if canReadModule(workspaceId,'customers')||canCreatePosSale(workspaceId);
allow create: if safeCreate(workspaceId) && (
  // Owner / admin / accountant — can create any transaction type
  canEditModule(workspaceId,'customers')
  || canEditModule(workspaceId,'finance')
  // Cashier — ONLY debit transactions with source 'order_payment'
  || (canCreatePosSale(workspaceId)
      && request.resource.data.type == 'debit'
      && request.resource.data.source == 'order_payment')
);
allow update: if false;
allow delete: if false;
}
