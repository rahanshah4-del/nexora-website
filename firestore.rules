'email','fullName','displayName','name','company','companyName','ownerName','phone','phoneNormalized','provider','photoURL','emailVerified','emailVerifiedCustom',
'role','status','isAdmin','onboardingCompleted',
'businessType','selectedBusinessType','currentBusinessType','primaryBusinessType','allowedBusinessTypes','selectedWorkspace','enabledModules','selectedFeatures','specialModuleAccess','allModulesAccess','shortClientId','workspaceName','trialBusinessType',
'country','currency','currencySymbol','address','preferredLanguage','academicYear','classesRange','monthlyFeeSetup','setupDetails',
'plan','planStatus','subscriptionStatus','trialDays','billingCycle','trialStartAt','trialStartedAt','trialEndsAt','isTrialActive',
'createdAt','createdBy','updatedAt','lastLoginAt','loginAt','lastLogin','lastActiveAt','lastAccessedAt','isOnline','device','browser',
'ipAddress','ipCountry','ipCity','ipRegion','ipTimezone','ipColo','ipAsn','ipOrganization','lastIpAddress','ipCapturedAt','lastIpCapturedAt',
