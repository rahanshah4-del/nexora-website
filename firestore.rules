match /upgradeRequests/{requestId} {
allow create: if isAdmin()||(activeSignedIn()&&clientUpgradeRequestCreateSafe());
allow read: if isAdmin()||paymentWorker()||(activeSignedIn()&&resource.data.userId==request.auth.uid);
allow update: if isAdmin()||validPaymentRequestUpdate();
allow delete: if isAdmin();
match /timeline/{timelineId} {
allow read: if isAdmin()
|| paymentWorker()
|| (
activeSignedIn()
&& get(/databases/$(database)/documents/upgradeRequests/$(requestId)).data.userId==request.auth.uid
);
allow create: if isAdmin()
|| (
activeSignedIn()
&& get(/databases/$(database)/documents/upgradeRequests/$(requestId)).data.userId==request.auth.uid
&& request.resource.data.actor=='client'
&& request.resource.data.message is string
&& request.resource.data.message.size()>0
&& request.resource.data.message.size()<=2000
&& request.resource.data.createdAt is timestamp
);
allow update,delete: if false;
}
}
match /platformSettings/{docId} {
allow read: if true;
allow write: if isAdmin();
}
match /platformPlans/{docId} {
allow read: if true;
allow write: if isAdmin();
}
match /promoCodes/{promoId} {
allow get: if paymentWorker()||(
activeSignedIn()
&& resource.data.active==true
&& resource.data.startsAt<=request.time
&& resource.data.expiresAt>request.time
&& (resource.data.usageLimit==0||resource.data.usedCount<resource.data.usageLimit)
);
allow list: if isAdmin();
allow create: if isAdmin()
&& validPromoCode(request.resource.data,promoId)
&& request.resource.data.createdAt==request.time
&& request.resource.data.updatedAt==request.time
&& request.resource.data.createdBy==request.auth.uid
&& request.resource.data.updatedBy==request.auth.uid
&& request.resource.data.usedCount==0;
allow update: if (
isAdmin()
&& validPromoCode(request.resource.data,promoId)
&& request.resource.data.code==resource.data.code
&& request.resource.data.createdAt==resource.data.createdAt
&& request.resource.data.createdBy==resource.data.createdBy
&& request.resource.data.updatedAt>=request.time - duration.value(5,'m')
&& request.resource.data.updatedAt<=request.time + duration.value(5,'m')
&& request.resource.data.updatedBy==request.auth.uid
)||(
paymentWorker()
&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount','updatedAt'])
&& request.resource.data.usedCount==resource.data.usedCount + 1
&& request.resource.data.updatedAt>=request.time - duration.value(5,'m')
&& request.resource.data.updatedAt<=request.time + duration.value(5,'m')
&& (resource.data.usageLimit==0||request.resource.data.usedCount<=resource.data.usageLimit)
);
allow delete: if isAdmin();
}
