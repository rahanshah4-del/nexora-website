match /products/{docId} {
allow read: if canReadModule(workspaceId,'products')||canReadModule(workspaceId,'inventory')||canReadModule(workspaceId,'pos')||canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'menuManagement');
