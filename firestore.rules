rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Promo model: promoCodes/{UPPERCASE_CODE}. Backend admins own lifecycle
    // management; signed-in clients may only get a currently usable exact code.
    // Upgrade/payment records store the original, discount, and final amounts.
    function signedIn() {
      return request.auth != null;
    }

    function backendAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['admin@nexora.com', 'rahanshah2@gmail.com'];
    }

    function paymentWorker() {
      return signedIn() && request.auth.uid == 's1CRduKudqM96Tp6g9E7XcTVzHF2';
    }

    function validPaymentRequestUpdate() {
      return paymentWorker()
        && resource.data.get('automaticVerification', false) == true
        && resource.data.get('paymentMethodId', '') == 'nowpayments'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvalStatus',
          'paymentStatus',
          'amountPaid',
          'paidCurrency',
          'nowPaymentsPaymentId',
          'lastIpnAt',
          'autoApprovedAt',
          'approvedAt',
          'approvedBy',
          'subscriptionExpiresAt',
          'nextBillingDate',
          'updatedAt'
        ])
        && request.resource.data.nowPaymentsPaymentId is string
        && request.resource.data.nowPaymentsPaymentId.size() > 0
        && request.resource.data.nowPaymentsPaymentId.size() <= 128
        && request.resource.data.lastIpnAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status == 'approved'
            && request.resource.data.approvalStatus == 'approved'
            && request.resource.data.paymentStatus == 'paid'
            && request.resource.data.amountPaid is number
            && request.resource.data.amountPaid >= 0
            && request.resource.data.paidCurrency is string
            && request.resource.data.paidCurrency.size() <= 20
            && request.resource.data.autoApprovedAt is timestamp
            && request.resource.data.approvedAt is timestamp
            && request.resource.data.approvedBy is string
            && request.resource.data.approvedBy.matches('^nowpayments:[A-Za-z0-9_-]+$')
            && request.resource.data.subscriptionExpiresAt is timestamp
            && request.resource.data.nextBillingDate is timestamp
          )
          ||
          (
            request.resource.data.status in ['waiting', 'confirming', 'confirmed', 'sending', 'partially_paid', 'failed', 'refunded', 'expired']
            && request.resource.data.paymentStatus == request.resource.data.status
            && request.resource.data.approvalStatus == resource.data.approvalStatus
          )
        );
    }

    function validPaymentSubscriptionCore() {
      let checkoutId = request.resource.data.paymentCheckoutId;
      let approval = getAfter(/databases/$(database)/documents/upgradeRequests/$(checkoutId)).data;
      return paymentWorker()
        && checkoutId is string
        && checkoutId.matches('^[A-Za-z0-9_-]{20,120}$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'plan',
          'planStatus',
          'subscriptionStatus',
          'billingCycle',
          'billingCurrency',
          'subscriptionStartedAt',
          'subscriptionExpiresAt',
          'nextBillingDate',
          'expiresAt',
          'isTrialActive',
          'upgradedAt',
          'approvedAt',
          'approvedBy',
          'approvedByEmail',
          'paymentCheckoutId',
          'updatedAt'
        ])
        && request.resource.data.plan is string
        && request.resource.data.plan.size() > 0
        && request.resource.data.plan.size() <= 80
        && request.resource.data.planStatus == 'active'
        && request.resource.data.subscriptionStatus == 'active'
        && request.resource.data.billingCycle in ['monthly', 'yearly']
        && request.resource.data.billingCurrency is string
        && request.resource.data.billingCurrency.size() > 0
        && request.resource.data.billingCurrency.size() <= 10
        && request.resource.data.subscriptionStartedAt is timestamp
        && request.resource.data.subscriptionStartedAt >= request.time - duration.value(5, 'm')
        && request.resource.data.subscriptionStartedAt <= request.time + duration.value(5, 'm')
        && request.resource.data.subscriptionExpiresAt is timestamp
        && request.resource.data.subscriptionExpiresAt > request.resource.data.subscriptionStartedAt
        && request.resource.data.subscriptionExpiresAt <= request.resource.data.subscriptionStartedAt + duration.value(367, 'd')
        && request.resource.data.nextBillingDate is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.isTrialActive == false
        && request.resource.data.upgradedAt is timestamp
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.approvedBy is string
        && request.resource.data.approvedBy.matches('^nowpayments:[A-Za-z0-9_-]+$')
        && request.resource.data.approvedByEmail == ''
        && request.resource.data.updatedAt is timestamp
        && approval.get('automaticVerification', false) == true
        && approval.get('paymentMethodId', '') == 'nowpayments'
        && approval.status == 'approved'
        && approval.approvalStatus == 'approved'
        && approval.paymentStatus == 'paid'
        && approval.approvedBy == request.resource.data.approvedBy;
    }

    function validPaymentUserUpdate(uid) {
      let approval = getAfter(/databases/$(database)/documents/upgradeRequests/$(request.resource.data.paymentCheckoutId)).data;
      return validPaymentSubscriptionCore() && approval.ownerId == uid;
    }

    function validPaymentWorkspaceUpdate(workspaceId) {
      let approval = getAfter(/databases/$(database)/documents/upgradeRequests/$(request.resource.data.paymentCheckoutId)).data;
      return validPaymentSubscriptionCore() && approval.workspaceId == workspaceId;
    }

    function validPlatformPaymentWrite() {
      let checkoutId = request.resource.data.sourceId;
      let approval = getAfter(/databases/$(database)/documents/upgradeRequests/$(checkoutId)).data;
      return paymentWorker()
        && request.resource.data.keys().hasOnly([
          'clientEmail',
          'workspaceId',
          'workspaceName',
          'plan',
          'amount',
          'originalAmount',
          'discountAmount',
          'promoCode',
          'promoCodeId',
          'currency',
          'cryptoAmountPaid',
          'cryptoCurrency',
          'transactionId',
          'paymentMethod',
          'status',
          'paymentStatus',
          'approvedBy',
          'approvedAt',
          'subscriptionExpiresAt',
          'nextBillingDate',
          'source',
          'sourceId',
          'updatedAt'
        ])
        && checkoutId is string
        && checkoutId.matches('^[A-Za-z0-9_-]{20,120}$')
        && request.resource.data.workspaceId == approval.workspaceId
        && request.resource.data.clientEmail is string
        && request.resource.data.clientEmail.size() <= 254
        && request.resource.data.workspaceName is string
        && request.resource.data.workspaceName.size() <= 200
        && request.resource.data.plan == approval.requestedPlan
        && request.resource.data.plan is string
        && request.resource.data.plan.size() <= 80
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.originalAmount is number
        && request.resource.data.originalAmount >= request.resource.data.amount
        && request.resource.data.discountAmount is number
        && request.resource.data.discountAmount >= 0
        && request.resource.data.promoCode is string
        && request.resource.data.promoCode.size() <= 32
        && request.resource.data.promoCodeId == request.resource.data.promoCode
        && (
          request.resource.data.promoCode == ''
          || request.resource.data.promoCode.matches('^[A-Z0-9_-]{3,32}$')
        )
        && request.resource.data.currency is string
        && request.resource.data.currency.size() > 0
        && request.resource.data.currency.size() <= 10
        && request.resource.data.cryptoAmountPaid is number
        && request.resource.data.cryptoAmountPaid >= 0
        && request.resource.data.cryptoCurrency is string
        && request.resource.data.cryptoCurrency.size() <= 20
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() > 0
        && request.resource.data.transactionId.size() <= 128
        && request.resource.data.paymentMethod == 'Crypto (NOWPayments)'
        && request.resource.data.status == 'paid'
        && request.resource.data.paymentStatus == 'paid'
        && request.resource.data.approvedBy == approval.approvedBy
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.subscriptionExpiresAt is timestamp
        && request.resource.data.nextBillingDate is timestamp
        && request.resource.data.source == 'nowpayments-ipn'
        && request.resource.data.updatedAt is timestamp
        && approval.get('automaticVerification', false) == true
        && approval.get('originalAmount', approval.amount) == request.resource.data.originalAmount
        && approval.get('discountAmount', 0) == request.resource.data.discountAmount
        && approval.get('promoCode', '') == request.resource.data.promoCode
        && approval.get('paymentMethodId', '') == 'nowpayments'
        && approval.status == 'approved'
        && approval.approvalStatus == 'approved'
        && approval.paymentStatus == 'paid';
    }

    function validPromoCode(data, promoId) {
      return data.keys().hasAll([
          'code', 'description', 'discountType', 'discountValue', 'maxDiscount',
          'minOrderAmount', 'applicablePlanIds', 'billingCycles', 'startsAt',
          'expiresAt', 'usageLimit', 'usedCount', 'active',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'code', 'description', 'discountType', 'discountValue', 'maxDiscount',
          'minOrderAmount', 'applicablePlanIds', 'billingCycles', 'startsAt',
          'expiresAt', 'usageLimit', 'usedCount', 'active',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.code == promoId
        && data.code is string
        && data.code.matches('^[A-Z0-9_-]{3,32}$')
        && data.description is string
        && data.description.size() <= 200
        && data.discountType in ['percentage', 'fixed']
        && data.discountValue is number
        && data.discountValue > 0
        && data.discountValue <= (data.discountType == 'percentage' ? 100 : 100000000)
        && data.maxDiscount is number
        && data.maxDiscount >= 0
        && data.maxDiscount <= 100000000
        && data.minOrderAmount is number
        && data.minOrderAmount >= 0
        && data.minOrderAmount <= 100000000
        && data.applicablePlanIds is list
        && data.applicablePlanIds.size() > 0
        && data.applicablePlanIds.size() <= 10
        && data.applicablePlanIds[0] is string
        && data.billingCycles is list
        && data.billingCycles.size() > 0
        && data.billingCycles.size() <= 2
        && data.billingCycles.hasOnly(['monthly', 'yearly'])
        && data.startsAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > data.startsAt
        && data.expiresAt <= data.startsAt + duration.value(3660, 'd')
        && data.usageLimit is int
        && data.usageLimit >= 0
        && data.usageLimit <= 10000000
        && data.usedCount is int
        && data.usedCount >= 0
        && (data.usageLimit == 0 || data.usedCount <= data.usageLimit)
        && data.active is bool
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 128
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.updatedBy.size() <= 128;
    }

    function validAnalyticsEvent() {
      return request.resource.data.keys().hasOnly([
          'eventType',
          'page',
          'buttonLabel',
          'moduleName',
          'userId',
          'email',
          'phone',
          'workspaceId',
          'businessType',
          'status',
          'sessionId',
          'visitorId',
          'referrer',
          'deviceType',
          'browser',
          'os',
          'country',
          'userAgent',
          'sessionDurationMs',
          'timestamp',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'eventType',
          'page',
          'sessionId',
          'visitorId',
          'timestamp',
          'createdAt'
        ])
        && request.resource.data.eventType is string
        && request.resource.data.eventType.size() > 0
        && request.resource.data.eventType.size() <= 80
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 200
        && request.resource.data.buttonLabel is string
        && request.resource.data.buttonLabel.size() <= 160
        && request.resource.data.moduleName is string
        && request.resource.data.moduleName.size() <= 120
        && request.resource.data.userId is string
        && request.resource.data.userId.size() <= 128
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId.size() <= 128
        && request.resource.data.businessType is string
        && request.resource.data.businessType.size() <= 80
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 120
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.sessionId.size() <= 160
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() > 0
        && request.resource.data.visitorId.size() <= 160
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 500
        && request.resource.data.deviceType is string
        && request.resource.data.deviceType.size() <= 40
        && request.resource.data.browser is string
        && request.resource.data.browser.size() <= 40
        && request.resource.data.os is string
        && request.resource.data.os.size() <= 40
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 80
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500
        && request.resource.data.sessionDurationMs is number
        && request.resource.data.sessionDurationMs >= 0
        && request.resource.data.sessionDurationMs <= 86400000
        && request.resource.data.timestamp == request.time
        && request.resource.data.createdAt == request.time;
    }

    function marketingAdmin() {
      return backendAdmin()
        || (
          signedIn()
          && request.auth.token.email_verified != false
          && (
            request.auth.token.admin == true
            || request.auth.token.owner == true
            || request.auth.token.role in ['admin', 'Admin', 'ADMIN', 'owner', 'Owner', 'OWNER']
          )
        );
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userStatusActive() {
      // Safe field access — a missing `status` field would otherwise raise an
      // evaluation error that denies the request (see workspaceActive).
      return !hasUserDoc()
        || !(userDoc(request.auth.uid).get('status', 'active') in ['blocked', 'Blocked', 'BLOCKED', 'disabled', 'Disabled', 'DISABLED', 'inactive', 'Inactive', 'INACTIVE']);
    }

    function workspaceDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function workspaceActive(workspaceId) {
      // Use .get(field, default) — accessing a field that does not exist on the
      // document raises an evaluation error that DENIES the whole rule. Bootstrap
      // -created trial workspaces have no `accountStatus` (and may lack `status`),
      // which silently broke every workspace update + member-gated subcollection
      // write (the "could not create your first workspace" permission error).
      return workspaceExists(workspaceId)
        && !(workspaceDoc(workspaceId).get('status', 'active') in ['blocked', 'Blocked', 'BLOCKED', 'disabled', 'Disabled', 'DISABLED', 'inactive', 'Inactive', 'INACTIVE'])
        && !(workspaceDoc(workspaceId).get('accountStatus', 'active') in ['blocked', 'Blocked', 'BLOCKED', 'disabled', 'Disabled', 'DISABLED', 'inactive', 'Inactive', 'INACTIVE']);
    }

    function activeSignedIn() {
      return signedIn() && userStatusActive();
    }

    function isOwnerRole(role) {
      return role in ['owner', 'Owner', 'OWNER'];
    }

    function isAdminRole(role) {
      return role in ['admin', 'Admin', 'ADMIN'];
    }

    function isManagerRole(role) {
      return role in ['manager', 'Manager', 'MANAGER'];
    }

    function isSalesRole(role) {
      return role in ['sales', 'Sales', 'SALES', 'sales staff', 'Sales Staff', 'STAFF', 'staff', 'Staff'];
    }

    function isAccountantRole(role) {
      return role in ['accountant', 'Accountant', 'ACCOUNTANT'];
    }

    function profileWorkspaceMatches(workspaceId) {
      return hasUserDoc()
        && (
          request.auth.uid == workspaceId
          || userDoc(request.auth.uid).workspaceId == workspaceId
          || userDoc(request.auth.uid).ownerId == workspaceId
          || userDoc(request.auth.uid).companyId == workspaceId
          || userDoc(request.auth.uid).userId == workspaceId
          || (userDoc(request.auth.uid).workspaceIds is list && workspaceId in userDoc(request.auth.uid).workspaceIds)
          || (userDoc(request.auth.uid).workspaces is list && workspaceId in userDoc(request.auth.uid).workspaces)
        );
    }

    function workspaceOwner(workspaceId) {
      return activeSignedIn()
        && workspaceActive(workspaceId)
        && (
          request.auth.uid == workspaceId
          || workspaceDoc(workspaceId).ownerId == request.auth.uid
          || workspaceDoc(workspaceId).createdBy == request.auth.uid
          || workspaceDoc(workspaceId).userId == request.auth.uid
          || workspaceDoc(workspaceId).uid == request.auth.uid
          || (profileWorkspaceMatches(workspaceId) && isOwnerRole(userDoc(request.auth.uid).role))
        );
    }

    function workspaceAdmin(workspaceId) {
      return backendAdmin()
        || workspaceOwner(workspaceId)
        || (
          activeSignedIn()
          && workspaceActive(workspaceId)
          && profileWorkspaceMatches(workspaceId)
          && isAdminRole(userDoc(request.auth.uid).role)
        );
    }

    function workspaceMember(workspaceId) {
      return workspaceAdmin(workspaceId)
        || (
          activeSignedIn()
          && workspaceActive(workspaceId)
          && profileWorkspaceMatches(workspaceId)
        );
    }

    function memberRole() {
      return hasUserDoc() ? userDoc(request.auth.uid).role : '';
    }

    function permissionDocId() {
      return hasUserDoc() && userDoc(request.auth.uid).staffId is string
        ? userDoc(request.auth.uid).staffId
        : request.auth.uid;
    }

    function permissionDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/permissions/$(permissionDocId())).data;
    }

    function hasPermission(workspaceId, key) {
      return workspaceAdmin(workspaceId)
        || (
          workspaceMember(workspaceId)
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/permissions/$(permissionDocId()))
          && permissionDoc(workspaceId)[key] == true
        );
    }

    function canManageWorkspace(workspaceId) {
      return workspaceAdmin(workspaceId)
        || (workspaceMember(workspaceId) && isManagerRole(memberRole()));
    }

    function canWriteSales(workspaceId) {
      return workspaceAdmin(workspaceId)
        || (workspaceMember(workspaceId) && (isManagerRole(memberRole()) || isSalesRole(memberRole())))
        || hasPermission(workspaceId, 'leadsManagement')
        || hasPermission(workspaceId, 'customerManagement')
        || hasPermission(workspaceId, 'invoices');
    }

    function canWriteAccounting(workspaceId) {
      return workspaceAdmin(workspaceId)
        || (workspaceMember(workspaceId) && (isManagerRole(memberRole()) || isAccountantRole(memberRole())))
        || hasPermission(workspaceId, 'invoices')
        || hasPermission(workspaceId, 'reports');
    }

    function safeCreate(workspaceId) {
      return request.resource.data.workspaceId == workspaceId
        && request.resource.data.createdBy == request.auth.uid
        && (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId);
    }

    function safeUpdate(workspaceId) {
      return (!request.resource.data.keys().hasAny(['workspaceId']) || request.resource.data.workspaceId == workspaceId)
        && (!resource.data.keys().hasAny(['workspaceId']) || request.resource.data.workspaceId == resource.data.workspaceId)
        && (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == workspaceId || request.resource.data.ownerId == workspaceDoc(workspaceId).ownerId)
        && (!resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == resource.data.ownerId);
    }

    function protectedWorkspaceFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'planStatus',
        'subscriptionStatus',
        'billingCycle',
        'role',
        'isAdmin',
        'trialStartAt',
        'trialStartedAt',
        'trialEndsAt',
        'isTrialActive',
        'billingCurrency',
        'nextBillingDate',
        'subscriptionStartedAt',
        'subscriptionExpiresAt',
        'expiresAt'
      ]);
    }

    function ownerMemberTarget(workspaceId, memberId) {
      return memberId == workspaceId
        || memberId == workspaceDoc(workspaceId).ownerId
        || request.resource.data.uid == workspaceDoc(workspaceId).ownerId
        || request.resource.data.staffId == workspaceDoc(workspaceId).ownerId
        || isOwnerRole(request.resource.data.role);
    }

    function ownerMemberResource(workspaceId, memberId) {
      return memberId == workspaceId
        || memberId == workspaceDoc(workspaceId).ownerId
        || resource.data.uid == workspaceDoc(workspaceId).ownerId
        || resource.data.staffId == workspaceDoc(workspaceId).ownerId
        || isOwnerRole(resource.data.role);
    }

    function ownerMemberWriteSafe(workspaceId, memberId) {
      return (!ownerMemberTarget(workspaceId, memberId) || (isOwnerRole(request.resource.data.role) && !(request.resource.data.status in ['blocked', 'disabled', 'inactive', 'Blocked', 'Disabled', 'Inactive'])))
        && (!ownerMemberResource(workspaceId, memberId) || isOwnerRole(request.resource.data.role));
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if backendAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if backendAdmin()
        || (paymentWorker() && validPaymentUserUpdate(uid))
        || (signedIn()
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'plan', 'planStatus', 'subscriptionStatus']));
      allow delete: if backendAdmin();

      match /{subPath=**} {
        allow read, write: if backendAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    match /phoneRegistry/{phoneId} {
      // Single-doc reads are public so the signup form can check phone
      // uniqueness BEFORE the user is authenticated. `get` only reveals whether
      // a phone you already know is taken; `list` (bulk enumeration) stays
      // admin-only to prevent harvesting the registry.
      allow get: if true;
      allow list: if backendAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if backendAdmin();
    }

    match /workspaces/{workspaceId} {
      allow create: if activeSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.createdBy == request.auth.uid;
      // The owner can always read their OWN workspace doc (workspaces/{uid}),
      // even if it doesn't exist yet (brand-new account, pre-onboarding) or is
      // blocked. This prevents a permission-denied read from being mistaken for
      // "account blocked", and lets the app read an explicit blocked status to
      // show the proper screen. Subcollections still require workspaceMember
      // (active), so a blocked workspace's DATA stays protected.
      allow read: if backendAdmin()
        || (signedIn() && request.auth.uid == workspaceId)
        || workspaceMember(workspaceId);
      allow update: if backendAdmin()
        || (paymentWorker() && validPaymentWorkspaceUpdate(workspaceId))
        || (workspaceAdmin(workspaceId) && protectedWorkspaceFieldsUnchanged());
      allow delete: if backendAdmin();

      match /permissions/{staffId} {
        allow read: if workspaceAdmin(workspaceId) || (workspaceMember(workspaceId) && staffId == permissionDocId());
        allow create, update, delete: if canManageWorkspace(workspaceId) && staffId != workspaceId && staffId != workspaceDoc(workspaceId).ownerId;
      }

      match /staff/{staffId} {
        allow read: if workspaceAdmin(workspaceId) || (workspaceMember(workspaceId) && staffId == permissionDocId());
        allow create, update: if canManageWorkspace(workspaceId) && safeUpdate(workspaceId) && ownerMemberWriteSafe(workspaceId, staffId);
        allow delete: if canManageWorkspace(workspaceId) && !ownerMemberResource(workspaceId, staffId);
      }

      match /teamMembers/{memberId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update: if canManageWorkspace(workspaceId) && safeUpdate(workspaceId) && ownerMemberWriteSafe(workspaceId, memberId);
        allow delete: if canManageWorkspace(workspaceId) && !ownerMemberResource(workspaceId, memberId);
      }

      match /teamPermissions/{permissionId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if canManageWorkspace(workspaceId);
      }

      match /businessSettings/{settingId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if workspaceAdmin(workspaceId) || hasPermission(workspaceId, 'settingsAccess');
      }

      match /whatsappSettings/{settingId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if workspaceAdmin(workspaceId) || hasPermission(workspaceId, 'settingsAccess');
      }

      match /customers/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /leads/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesDeals/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesTasks/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesActivities/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesQuotes/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesProducts/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteSales(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteSales(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesInvoices/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /salesExpenses/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /orders/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if workspaceMember(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /menuItems/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canManageWorkspace(workspaceId) && safeCreate(workspaceId);
        allow update: if canManageWorkspace(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /tables/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canManageWorkspace(workspaceId) && safeCreate(workspaceId);
        allow update: if workspaceMember(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /kot/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if workspaceMember(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /bills/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /restaurantSettings/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if workspaceAdmin(workspaceId) || hasPermission(workspaceId, 'settingsAccess');
      }

      match /reports/{docId} {
        allow read: if workspaceMember(workspaceId) || hasPermission(workspaceId, 'reports');
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update, delete: if canManageWorkspace(workspaceId);
      }

      match /invoices/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /payments/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /expenses/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /accountTransactions/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if canWriteAccounting(workspaceId) && safeCreate(workspaceId);
        allow update: if canWriteAccounting(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }

      match /activityLogs/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /notifications/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create, update, delete: if workspaceMember(workspaceId);
      }

      match /supportTickets/{docId} {
        allow read: if backendAdmin() || workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if backendAdmin() || (workspaceMember(workspaceId) && safeUpdate(workspaceId));
        allow delete: if backendAdmin() || canManageWorkspace(workspaceId);
      }

      match /{collectionName}/{docId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if workspaceMember(workspaceId) && safeCreate(workspaceId);
        allow update: if workspaceMember(workspaceId) && safeUpdate(workspaceId);
        allow delete: if canManageWorkspace(workspaceId);
      }
    }

    match /upgradeRequests/{requestId} {
      allow create: if activeSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if backendAdmin() || paymentWorker() || (activeSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if backendAdmin() || validPaymentRequestUpdate();
      allow delete: if backendAdmin();
    }

    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if backendAdmin();
    }

    match /platformPlans/{docId} {
      allow read: if true;
      allow write: if backendAdmin();
    }

    match /promoCodes/{promoId} {
      allow get: if paymentWorker() || (
        activeSignedIn()
          && resource.data.active == true
          && resource.data.startsAt <= request.time
          && resource.data.expiresAt > request.time
          && (resource.data.usageLimit == 0 || resource.data.usedCount < resource.data.usageLimit)
        );
      allow list: if backendAdmin();
      allow create: if backendAdmin()
        && validPromoCode(request.resource.data, promoId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.usedCount == 0;
      allow update: if (
          backendAdmin()
          && validPromoCode(request.resource.data, promoId)
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt >= request.time - duration.value(5, 'm')
          && request.resource.data.updatedAt <= request.time + duration.value(5, 'm')
          && request.resource.data.updatedBy == request.auth.uid
        ) || (
          paymentWorker()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'updatedAt'])
          && request.resource.data.usedCount == resource.data.usedCount + 1
          && request.resource.data.updatedAt >= request.time - duration.value(5, 'm')
          && request.resource.data.updatedAt <= request.time + duration.value(5, 'm')
          && (resource.data.usageLimit == 0 || request.resource.data.usedCount <= resource.data.usageLimit)
        );
      allow delete: if backendAdmin();
    }

    match /whatsappPricing/{docId} {
      allow read: if true;
      allow write: if backendAdmin();
    }

    match /platformPayments/{docId} {
      allow read: if backendAdmin();
      allow create, update: if backendAdmin() || validPlatformPaymentWrite();
      allow delete: if backendAdmin();
    }

    match /platformSubscriptions/{docId} {
      allow read, write: if backendAdmin();
    }

    match /marketingSubscribers/{docId} {
      allow read, write: if marketingAdmin();
    }

    match /marketingCampaigns/{docId} {
      allow read, write: if marketingAdmin();
    }

    match /marketingEmailLogs/{docId} {
      allow read, write: if marketingAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if backendAdmin();
    }

    match /supportTickets/{docId} {
      allow create: if activeSignedIn();
      allow read, update, delete: if backendAdmin() || (activeSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /backendStaff/{docId} {
      allow read, write: if backendAdmin();
    }

    match /backendActivityLogs/{docId} {
      allow read, write: if backendAdmin();
    }

    match /analyticsEvents/{docId} {
      allow create: if validAnalyticsEvent();
      allow read, update, delete: if backendAdmin();
    }

    match /userSessions/{docId} {
      allow create: if activeSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if backendAdmin() || (activeSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if backendAdmin();
    }
  }
}
