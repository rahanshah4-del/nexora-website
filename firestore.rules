}
match /workspaces/{workspaceId} {
allow create: if activeSignedIn()
&& request.resource.data.ownerId==request.auth.uid
&& request.resource.data.workspaceId==workspaceId
&& request.resource.data.createdBy==request.auth.uid;
allow read: if backendAdmin()
|| (signedIn()&&request.auth.uid==workspaceId)
|| workspaceMember(workspaceId);
allow update: if backendAdmin()
|| (paymentWorker()&&validPaymentWorkspaceUpdate(workspaceId))
|| (workspaceAdmin(workspaceId)&&protectedWorkspaceFieldsUnchanged());
allow delete: if backendAdmin();
match /permissions/{staffId} {
allow read: if workspaceAdmin(workspaceId)||(workspaceMember(workspaceId)&&staffId==permissionDocId());
allow create,update,delete: if canManageWorkspace(workspaceId)&&staffId!=workspaceId&&staffId!=workspaceDoc(workspaceId).ownerId;
}
match /staff/{staffId} {
allow read: if workspaceAdmin(workspaceId)||(workspaceMember(workspaceId)&&staffId==permissionDocId());
allow create: if canManageWorkspace(workspaceId)&&safeCreate(workspaceId)&&ownerMemberWriteSafe(workspaceId,staffId);
allow update: if canManageWorkspace(workspaceId)&&safeUpdate(workspaceId)&&ownerMemberWriteSafe(workspaceId,staffId);
allow delete: if canManageWorkspace(workspaceId)&&!ownerMemberResource(workspaceId,staffId);
}
