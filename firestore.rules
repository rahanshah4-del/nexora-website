rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
function signedIn() {
return request.auth!=null;
}
function backendAdmin() {
return signedIn()
&& ('email_verified' in request.auth.token) && request.auth.token.email_verified==true
&& ('email' in request.auth.token) && request.auth.token.email in ['admin@nexora.com','rahanshah2@gmail.com','farhanshah2@gmail.com'];
}
function paymentWorker() {
return signedIn()&&request.auth.uid=='s1CRduKudqM96Tp6g9E7XcTVzHF2';
}
function nowPaymentsActor(value) {
return value is string&&value.matches('^nowpayments:[A-Za-z0-9_-]+$');
}
function validCheckoutId(value) {
return value is string&&value.matches('^[A-Za-z0-9_-]{20,120}$');
}
function validPaymentRequestFields() {
return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvalStatus','paymentStatus','amountPaid','paidCurrency','nowPaymentsPaymentId','lastIpnAt','autoApprovedAt','approvedAt','approvedBy','subscriptionExpiresAt','nextBillingDate','updatedAt']);
}
function validPaymentRequestBase() {
return paymentWorker()
&& resource.data.get('automaticVerification',false)==true
&& resource.data.get('paymentMethodId','')=='nowpayments'
&& validPaymentRequestFields()
&& request.resource.data.nowPaymentsPaymentId is string
&& request.resource.data.nowPaymentsPaymentId.size()>0
&& request.resource.data.nowPaymentsPaymentId.size()<=128
&& request.resource.data.lastIpnAt is timestamp
&& request.resource.data.updatedAt is timestamp;
}
function validApprovedPaymentRequest() {
return request.resource.data.status=='approved'
&& request.resource.data.approvalStatus=='approved'
&& request.resource.data.paymentStatus=='paid'
&& request.resource.data.amountPaid is number
&& request.resource.data.amountPaid>=0
&& request.resource.data.paidCurrency is string
&& request.resource.data.paidCurrency.size()<=20
&& request.resource.data.autoApprovedAt is timestamp
&& request.resource.data.approvedAt is timestamp
&& nowPaymentsActor(request.resource.data.approvedBy)
&& request.resource.data.subscriptionExpiresAt is timestamp
&& request.resource.data.nextBillingDate is timestamp;
}
function validPendingPaymentRequest() {
return request.resource.data.status in ['waiting','confirming','confirmed','sending','partially_paid','failed','refunded','expired']
&& request.resource.data.paymentStatus==request.resource.data.status
&& request.resource.data.approvalStatus==resource.data.approvalStatus;
}
function validPaymentRequestUpdate() {
return validPaymentRequestBase()
&& (validApprovedPaymentRequest()||validPendingPaymentRequest());
}
function validPaymentSubscriptionFields() {
return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan','planStatus','subscriptionStatus','billingCycle','billingCurrency','subscriptionStartedAt','subscriptionExpiresAt','nextBillingDate','expiresAt','isTrialActive','upgradedAt','approvedAt','approvedBy','approvedByEmail','paymentCheckoutId','updatedAt']);
}
function validPaymentSubscriptionPlan() {
return request.resource.data.plan is string
&& request.resource.data.plan.size()>0
&& request.resource.data.plan.size()<=80
&& request.resource.data.planStatus=='active'
&& request.resource.data.subscriptionStatus=='active'
&& request.resource.data.billingCycle in ['monthly','yearly']
&& request.resource.data.billingCurrency is string
&& request.resource.data.billingCurrency.size()>0
&& request.resource.data.billingCurrency.size()<=10;
}
function validPaymentSubscriptionDates() {
return request.resource.data.subscriptionStartedAt is timestamp
&& request.resource.data.subscriptionStartedAt>=request.time - duration.value(5,'m')
&& request.resource.data.subscriptionStartedAt<=request.time + duration.value(5,'m')
&& request.resource.data.subscriptionExpiresAt is timestamp
&& request.resource.data.subscriptionExpiresAt>request.resource.data.subscriptionStartedAt
&& request.resource.data.subscriptionExpiresAt<=request.resource.data.subscriptionStartedAt + duration.value(367,'d')
&& request.resource.data.nextBillingDate is timestamp
&& request.resource.data.expiresAt is timestamp;
}
function validPaymentSubscriptionApproval() {
return request.resource.data.upgradedAt is timestamp
&& request.resource.data.approvedAt is timestamp
&& nowPaymentsActor(request.resource.data.approvedBy)
&& request.resource.data.approvedByEmail==''
&& request.resource.data.updatedAt is timestamp;
}
function validPaymentSubscriptionApprovalDoc(approval) {
return approval.get('automaticVerification',false)==true
&& approval.get('paymentMethodId','')=='nowpayments'
&& approval.status=='approved'
&& approval.approvalStatus=='approved'
&& approval.paymentStatus=='paid'
&& approval.approvedBy==request.resource.data.approvedBy;
}
function validPaymentSubscriptionCore() {
let checkoutId = request.resource.data.paymentCheckoutId;
let approval = getAfter(/databases/$(database)/documents/upgradeRequests/$(checkoutId)).data;
return paymentWorker()
&& validCheckoutId(checkoutId)
&& validPaymentSubscriptionFields()
&& validPaymentSubscriptionPlan()
&& validPaymentSubscriptionDates()
&& request.resource.data.isTrialActive==false
&& validPaymentSubscriptionApproval()
&& validPaymentSubscriptionApprovalDoc(approval);
}
function validPaymentUserUpdate(uid) {
let approval = getAfter(/databases/$(database)/documents/upgradeRequests/$(request.resource.data.paymentCheckoutId)).data;
return validPaymentSubscriptionCore()&&approval.ownerId==uid;
}
function validPaymentWorkspaceUpdate(workspaceId) {
let approval = getAfter(/databases/$(database)/documents/upgradeRequests/$(request.resource.data.paymentCheckoutId)).data;
return validPaymentSubscriptionCore()&&approval.workspaceId==workspaceId;
}
function validPlatformPaymentFields() {
return request.resource.data.keys().hasOnly(['clientEmail','workspaceId','workspaceName','plan','amount','originalAmount','discountAmount','promoCode','promoCodeId','currency','cryptoAmountPaid','cryptoCurrency','transactionId','paymentMethod','status','paymentStatus','approvedBy','approvedAt','subscriptionExpiresAt','nextBillingDate','source','sourceId','updatedAt']);
}
function validPlatformPaymentClient(approval) {
return request.resource.data.workspaceId==approval.workspaceId
&& request.resource.data.clientEmail is string
&& request.resource.data.clientEmail.size()<=254
&& request.resource.data.workspaceName is string
&& request.resource.data.workspaceName.size()<=200
&& request.resource.data.plan==approval.requestedPlan
&& request.resource.data.plan is string
&& request.resource.data.plan.size()<=80;
}
function validPlatformPaymentAmounts(approval) {
return request.resource.data.amount is number
&& request.resource.data.amount>=0
&& request.resource.data.originalAmount is number
&& request.resource.data.originalAmount>=request.resource.data.amount
&& request.resource.data.discountAmount is number
&& request.resource.data.discountAmount>=0
&& request.resource.data.promoCode is string
&& request.resource.data.promoCode.size()<=32
&& request.resource.data.promoCodeId==request.resource.data.promoCode
&& (
request.resource.data.promoCode==''
|| request.resource.data.promoCode.matches('^[A-Z0-9_-]{3,32}$')
)
&& approval.get('originalAmount',approval.amount)==request.resource.data.originalAmount
&& approval.get('discountAmount',0)==request.resource.data.discountAmount
&& approval.get('promoCode','')==request.resource.data.promoCode;
}
function validPlatformPaymentCrypto() {
return request.resource.data.currency is string
&& request.resource.data.currency.size()>0
&& request.resource.data.currency.size()<=10
&& request.resource.data.cryptoAmountPaid is number
&& request.resource.data.cryptoAmountPaid>=0
&& request.resource.data.cryptoCurrency is string
&& request.resource.data.cryptoCurrency.size()<=20
&& request.resource.data.transactionId is string
&& request.resource.data.transactionId.size()>0
&& request.resource.data.transactionId.size()<=128;
}
function validPlatformPaymentStatus(approval) {
return request.resource.data.paymentMethod=='Crypto (NOWPayments)'
&& request.resource.data.status=='paid'
&& request.resource.data.paymentStatus=='paid'
&& request.resource.data.approvedBy==approval.approvedBy
&& request.resource.data.approvedAt is timestamp
&& request.resource.data.subscriptionExpiresAt is timestamp
&& request.resource.data.nextBillingDate is timestamp
&& request.resource.data.source=='nowpayments-ipn'
&& request.resource.data.updatedAt is timestamp;
}
function validPlatformPaymentApprovalDoc(approval) {
return approval.get('automaticVerification',false)==true
&& approval.get('paymentMethodId','')=='nowpayments'
&& approval.status=='approved'
&& approval.approvalStatus=='approved'
&& approval.paymentStatus=='paid';
}
function validPlatformPaymentWrite() {
let checkoutId = request.resource.data.sourceId;
let approval = getAfter(/databases/$(database)/documents/upgradeRequests/$(checkoutId)).data;
return paymentWorker()
&& validPlatformPaymentFields()
&& validCheckoutId(checkoutId)
&& validPlatformPaymentClient(approval)
&& validPlatformPaymentAmounts(approval)
&& validPlatformPaymentCrypto()
&& validPlatformPaymentStatus(approval)
&& validPlatformPaymentApprovalDoc(approval);
}
function validPromoCode(data,promoId) {
return data.keys().hasAll(['code','discountType','discountValue','startsAt','expiresAt','usageLimit','usedCount','active'])
&& data.keys().hasOnly(['code','description','discountType','discountValue','maxDiscount','minOrderAmount','applicablePlanIds','billingCycles','startsAt','expiresAt','usageLimit','usedCount','active','createdAt','createdBy','updatedAt','updatedBy'])
&& data.code==promoId
&& data.code is string
&& data.code.matches('^[A-Z0-9_-]{3,32}$')
&& data.discountType in ['percentage','fixed']
&& data.discountValue is number
&& data.discountValue>0
&& data.discountValue<=(data.discountType=='percentage' ? 100 : 100000000)
&& (!('maxDiscount' in data)||(data.maxDiscount is number&&data.maxDiscount>=0&&data.maxDiscount<=100000000))
&& (!('minOrderAmount' in data)||(data.minOrderAmount is number&&data.minOrderAmount>=0&&data.minOrderAmount<=100000000))
&& data.startsAt is timestamp
&& data.expiresAt is timestamp
&& data.expiresAt>data.startsAt
&& data.usageLimit is int
&& data.usageLimit>=0
&& data.usedCount is int
&& data.usedCount>=0
&& (data.usageLimit==0||data.usedCount<=data.usageLimit)
&& data.active is bool;
}
function validAnalyticsEvent() {
return request.resource.data.keys().hasAll(['eventType','page','sessionId','visitorId','timestamp','createdAt'])
&& request.resource.data.keys().hasOnly(['eventType','page','buttonLabel','moduleName','userId','email','phone','workspaceId','businessType','status','sessionId','visitorId','referrer','deviceType','browser','os','country','userAgent','sessionDurationMs','timestamp','createdAt'])
&& request.resource.data.eventType is string
&& request.resource.data.eventType.size()>0
&& request.resource.data.page is string
&& request.resource.data.sessionId is string
&& request.resource.data.sessionId.size()>0
&& request.resource.data.visitorId is string
&& request.resource.data.visitorId.size()>0
&& request.resource.data.timestamp==request.time
&& request.resource.data.createdAt==request.time;
}
function validBlogPost(data) {
return data.keys().hasAll(['slug','title','seoTitle','metaDescription','excerpt','category','tags','status','featuredImage','featuredImageAlt','sections','faqs','author','createdAt','updatedAt'])
&& data.keys().hasOnly(['slug','title','seoTitle','metaDescription','excerpt','category','tags','keywords','status','featuredImage','featuredImageAlt','sections','faqs','author','publishDate','createdAt','updatedAt','createdBy','createdByEmail'])
&& data.slug is string
&& data.slug.matches('^[a-z0-9-]{3,120}$')
&& data.title is string
&& data.title.size()>0
&& data.title.size()<=180
&& data.seoTitle is string
&& data.seoTitle.size()>0
&& data.seoTitle.size()<=220
&& data.metaDescription is string
&& data.metaDescription.size()>0
&& data.metaDescription.size()<=220
&& data.excerpt is string
&& data.excerpt.size()<=300
&& data.category is string
&& data.category.size()>0
&& data.category.size()<=80
&& data.tags is list
&& data.tags.size()<=20
&& data.status in ['draft','published']
&& data.featuredImage is string
&& data.featuredImage.size()>0
&& data.featuredImage.size()<=1000
&& data.featuredImageAlt is string
&& data.featuredImageAlt.size()>0
&& data.featuredImageAlt.size()<=180
&& data.sections is list
&& data.sections.size()>0
&& data.sections.size()<=20
&& data.faqs is list
&& data.faqs.size()<=20
&& data.author is map
&& data.createdAt is timestamp
&& data.updatedAt is timestamp;
}
function validBusinessService(data) {
return data.keys().hasAll(['title','description','startingPrice','priceType','enabled','featured','sortOrder','createdAt','updatedAt'])
&& data.keys().hasOnly(['title','description','startingPrice','priceType','enabled','featured','sortOrder','createdAt','updatedAt'])
&& data.title is string
&& data.title.size()>0
&& data.description is string
&& data.description.size()>0
&& data.startingPrice is number
&& data.startingPrice>=0
&& data.priceType in ['monthly','one-time','custom']
&& data.enabled is bool
&& data.featured is bool
&& data.sortOrder is number
&& data.createdAt is timestamp
&& data.updatedAt is timestamp;
}
function validBusinessServiceRequest(data) {
return data.keys().hasAll(['serviceId','serviceTitle','companyName','contactNumber','email','supportDetails','engagementType','status','createdAt','updatedAt'])
&& data.keys().hasOnly(['serviceId','serviceTitle','companyName','contactNumber','email','supportDetails','engagementType','preferredWorkingHours','notes','status','workspaceId','ownerId','userId','latestAdminRemark','latestClientComment','lastActivityAt','createdAt','updatedAt'])
&& data.serviceId is string
&& data.serviceId.size()>0
&& data.serviceTitle is string
&& data.companyName is string
&& data.contactNumber is string
&& data.email is string
&& data.supportDetails is string
&& data.engagementType in ['Full Time','Part Time']
&& data.status=='New'
&& (!('userId' in data)||(!signedIn()||data.userId==request.auth.uid))
&& data.createdAt==request.time
&& data.updatedAt==request.time;
}
function validBusinessServiceRequestStatusUpdate(data) {
return data.diff(resource.data).affectedKeys().hasOnly(['status','latestAdminRemark','lastActivityAt','updatedAt'])
&& data.status in ['New','Under Review','Proposal Sent','Approved','Active','Rejected','Closed']
&& data.latestAdminRemark is string
&& data.latestAdminRemark.size()<=1000
&& data.lastActivityAt is timestamp
&& data.updatedAt is timestamp;
}
function validBusinessServiceRequestClientCommentUpdate(data) {
return signedIn()
&& resource.data.userId==request.auth.uid
&& data.diff(resource.data).affectedKeys().hasOnly(['latestClientComment','lastActivityAt','updatedAt'])
&& data.latestClientComment is string
&& data.latestClientComment.size()>0
&& data.latestClientComment.size()<=1000
&& data.lastActivityAt is timestamp
&& data.updatedAt is timestamp;
}
function businessServiceRequestMember() {
return signedIn()
&& (
resource.data.userId==request.auth.uid
|| (resource.data.workspaceId is string&&resource.data.workspaceId.size()>0&&workspaceMember(resource.data.workspaceId))
);
}
function businessServiceRequestParentMember(requestId) {
let parent = get(/databases/$(database)/documents/businessServiceRequests/$(requestId)).data;
return signedIn()
&& (
parent.userId==request.auth.uid
|| (parent.workspaceId is string&&parent.workspaceId.size()>0&&workspaceMember(parent.workspaceId))
);
}
function validBusinessServiceRequestTimeline(data) {
return data.keys().hasOnly(['type','title','message','status','actor','actorId','actorEmail','createdAt'])
&& data.type is string
&& data.title is string
&& data.message is string
&& data.actor in ['client','admin','system']
&& data.actorId is string
&& data.createdAt==request.time;
}
function validBusinessServiceRequestComment(data) {
return data.keys().hasOnly(['message','actor','actorId','actorEmail','createdAt'])
&& data.message is string
&& data.actor=='client'
&& data.actorId==request.auth.uid
&& data.createdAt==request.time;
}
function marketingAdmin() {
return backendAdmin()
|| (
signedIn()
&& (!('email_verified' in request.auth.token) || request.auth.token.email_verified!=false)
&& (
(('admin' in request.auth.token) && request.auth.token.admin==true)
|| (('owner' in request.auth.token) && request.auth.token.owner==true)
|| (('role' in request.auth.token) && request.auth.token.role in ['admin','Admin','ADMIN','owner','Owner','OWNER'])
)
);
}
function userDoc(uid) {
return get(/databases/$(database)/documents/users/$(uid)).data;
}
function hasUserDoc() {
return signedIn()&&exists(/databases/$(database)/documents/users/$(request.auth.uid));
}
function userStatusActive() {
return !hasUserDoc()
|| !(userDoc(request.auth.uid).get('status','active') in ['blocked','Blocked','BLOCKED','disabled','Disabled','DISABLED','inactive','Inactive','INACTIVE']);
}
function workspaceDoc(workspaceId) {
return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
}
function workspaceExists(workspaceId) {
return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
}
function workspaceActive(workspaceId) {
return workspaceExists(workspaceId)
&& !(workspaceDoc(workspaceId).get('status','active') in ['blocked','Blocked','BLOCKED','disabled','Disabled','DISABLED','inactive','Inactive','INACTIVE'])
&& !(workspaceDoc(workspaceId).get('accountStatus','active') in ['blocked','Blocked','BLOCKED','disabled','Disabled','DISABLED','inactive','Inactive','INACTIVE']);
}
function activeSignedIn() {
return signedIn()&&userStatusActive();
}
function isOwnerRole(role) {
return role in ['owner','Owner','OWNER'];
}
function isAdminRole(role) {
return role in ['admin','Admin','ADMIN'];
}
function profileWorkspaceMatches(workspaceId) {
return hasUserDoc()
&& (
request.auth.uid==workspaceId
|| userDoc(request.auth.uid).workspaceId==workspaceId
);
}
function workspaceOwner(workspaceId) {
return activeSignedIn()
&& workspaceActive(workspaceId)
&& (
request.auth.uid==workspaceId
|| workspaceDoc(workspaceId).ownerId==request.auth.uid
|| workspaceDoc(workspaceId).createdBy==request.auth.uid
|| workspaceDoc(workspaceId).userId==request.auth.uid
|| workspaceDoc(workspaceId).uid==request.auth.uid
|| (profileWorkspaceMatches(workspaceId)&&isOwnerRole(userDoc(request.auth.uid).role))
);
}
function workspaceAdmin(workspaceId) {
return backendAdmin()
|| workspaceOwner(workspaceId)
|| (
activeSignedIn()
&& workspaceActive(workspaceId)
&& profileWorkspaceMatches(workspaceId)
&& isAdminRole(userDoc(request.auth.uid).role)
);
}
function workspaceMember(workspaceId) {
return workspaceAdmin(workspaceId)
|| (
activeSignedIn()
&& workspaceActive(workspaceId)
&& profileWorkspaceMatches(workspaceId)
);
}
function permissionDocId() {
return hasUserDoc()&&userDoc(request.auth.uid).staffId is string
? userDoc(request.auth.uid).staffId
: request.auth.uid;
}
function permissionDoc(workspaceId) {
return get(/databases/$(database)/documents/workspaces/$(workspaceId)/permissions/$(permissionDocId())).data;
}
function permissionDocExists(workspaceId) {
return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/permissions/$(permissionDocId()));
}
function permissionValue(workspaceId,key) {
return permissionDoc(workspaceId).get(key,false)==true;
}
function hasStaffPermission(workspaceId,key) {
return workspaceMember(workspaceId)
&& permissionDocExists(workspaceId)
&& permissionValue(workspaceId,key);
}
function hasPermission(workspaceId,key) {
return workspaceAdmin(workspaceId)||hasStaffPermission(workspaceId,key);
}
function hasModulePermission(workspaceId,moduleKey,action) {
return permissionValue(workspaceId,'module.' + moduleKey + '.' + action);
}
function hasAnyModulePermission(workspaceId,moduleKey,action) {
return hasModulePermission(workspaceId,moduleKey,action)
|| (moduleKey=='business_services'&&hasModulePermission(workspaceId,'businessServices',action))
|| (moduleKey=='businessServices'&&hasModulePermission(workspaceId,'business_services',action))
|| (moduleKey=='pos'&&(hasModulePermission(workspaceId,'retail_pos',action)||hasModulePermission(workspaceId,'retail',action)))
|| (moduleKey=='retail_pos'&&(hasModulePermission(workspaceId,'pos',action)||hasModulePermission(workspaceId,'retail',action)))
|| (moduleKey=='posOrders'&&(hasModulePermission(workspaceId,'pos_orders',action)||hasModulePermission(workspaceId,'retail_pos_orders',action)))
|| (moduleKey=='pos_orders'&&hasModulePermission(workspaceId,'posOrders',action));
}
function canReadModule(workspaceId,moduleKey) {
return workspaceAdmin(workspaceId)
|| (
activeSignedIn()
&& workspaceActive(workspaceId)
&& profileWorkspaceMatches(workspaceId)
&& permissionDocExists(workspaceId)
&& hasAnyModulePermission(workspaceId,moduleKey,'view')
);
}
function canCreateModule(workspaceId,moduleKey) {
return workspaceAdmin(workspaceId)
|| (
activeSignedIn()
&& workspaceActive(workspaceId)
&& profileWorkspaceMatches(workspaceId)
&& permissionDocExists(workspaceId)
&& hasAnyModulePermission(workspaceId,moduleKey,'create')
);
}
function canEditModule(workspaceId,moduleKey) {
return workspaceAdmin(workspaceId)
|| (
activeSignedIn()
&& workspaceActive(workspaceId)
&& profileWorkspaceMatches(workspaceId)
&& permissionDocExists(workspaceId)
&& hasAnyModulePermission(workspaceId,moduleKey,'edit')
);
}
function canDeleteModule(workspaceId,moduleKey) {
return workspaceAdmin(workspaceId)
|| (
activeSignedIn()
&& workspaceActive(workspaceId)
&& profileWorkspaceMatches(workspaceId)
&& permissionDocExists(workspaceId)
&& hasAnyModulePermission(workspaceId,moduleKey,'delete')
);
}
function canCreatePosSale(workspaceId) {
return workspaceAdmin(workspaceId)
|| canCreateModule(workspaceId,'pos')
|| canCreateModule(workspaceId,'posOrders')
|| canCreateModule(workspaceId,'orders');
}
function canManageWorkspace(workspaceId) {
return workspaceAdmin(workspaceId);
}
function safeCreate(workspaceId) {
return request.resource.data.workspaceId==workspaceId
&& request.resource.data.createdBy==request.auth.uid
&& (!request.resource.data.keys().hasAny(['ownerId'])||request.resource.data.ownerId==workspaceId||request.resource.data.ownerId==workspaceDoc(workspaceId).ownerId);
}
function safeUpdate(workspaceId) {
return (!request.resource.data.keys().hasAny(['workspaceId'])||request.resource.data.workspaceId==workspaceId)
&& (!resource.data.keys().hasAny(['workspaceId'])||request.resource.data.workspaceId==resource.data.workspaceId)
&& (!request.resource.data.keys().hasAny(['ownerId'])||request.resource.data.ownerId==workspaceId||request.resource.data.ownerId==workspaceDoc(workspaceId).ownerId)
&& (!resource.data.keys().hasAny(['ownerId'])||request.resource.data.ownerId==resource.data.ownerId);
}
function protectedWorkspaceFieldsUnchanged() {
return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan','planStatus','subscriptionStatus','billingCycle','role','isAdmin','trialStartAt','trialStartedAt','trialEndsAt','isTrialActive','billingCurrency','nextBillingDate','subscriptionStartedAt','subscriptionExpiresAt','expiresAt']);
}
function ownerMemberTarget(workspaceId,memberId) {
return memberId==workspaceId
|| memberId==workspaceDoc(workspaceId).ownerId
|| request.resource.data.uid==workspaceDoc(workspaceId).ownerId
|| request.resource.data.staffId==workspaceDoc(workspaceId).ownerId
|| isOwnerRole(request.resource.data.role);
}
function ownerMemberResource(workspaceId,memberId) {
return memberId==workspaceId
|| memberId==workspaceDoc(workspaceId).ownerId
|| resource.data.uid==workspaceDoc(workspaceId).ownerId
|| resource.data.staffId==workspaceDoc(workspaceId).ownerId
|| isOwnerRole(resource.data.role);
}
function ownerMemberWriteSafe(workspaceId,memberId) {
return (!ownerMemberTarget(workspaceId,memberId)||(isOwnerRole(request.resource.data.role)&&!(request.resource.data.status in ['blocked','disabled','inactive','Blocked','Disabled','Inactive'])))
&& (!ownerMemberResource(workspaceId,memberId)||isOwnerRole(request.resource.data.role));
}
function validStaffUserProfileFields(data) {
return data.keys().hasOnly(['uid','name','fullName','displayName','email','username','usernameLower','workspaceCode','teamWorkspaceCode','staffLoginId','staffShortCode','loginKey','pinLoginEnabled','pinUpdatedAt','failedLoginCount','lastFailedLoginAt','blockReason','role','status','createdBy','ownerId','companyId','workspaceId','userId','staffId','permissions','businessPermissions','businessType','selectedBusinessType','currentBusinessType','primaryBusinessType','allowedBusinessTypes','selectedWorkspace','enabledModules','plan','planStatus','billingCycle','provider','inviteStatus','emailVerifiedCustom','emailVerifiedCustomAt','onboardingCompleted','invitedAt','invitedBy','acceptedAt','lastLoginAt','inviteEmailStatus','inviteEmailError','inviteEmailSentAt','passwordSetPending','createdAt','updatedAt','updatedBy','authCreated','isStaff','isOwner','isAdmin']);
}
function validStaffLoginProfileFields(data) {
return (!data.keys().hasAny(['workspaceCode'])||(data.workspaceCode is string&&data.workspaceCode.size()>2&&data.workspaceCode.size()<=32))
&& (!data.keys().hasAny(['teamWorkspaceCode'])||(data.teamWorkspaceCode is string&&data.teamWorkspaceCode.size()>2&&data.teamWorkspaceCode.size()<=32))
&& (!data.keys().hasAny(['staffLoginId'])||(data.staffLoginId is string&&data.staffLoginId.size()>2&&data.staffLoginId.size()<=32))
&& (!data.keys().hasAny(['staffShortCode'])||(data.staffShortCode is string&&data.staffShortCode.size()>2&&data.staffShortCode.size()<=32))
&& (!data.keys().hasAny(['loginKey'])||(data.loginKey is string&&data.loginKey.size()>4&&data.loginKey.size()<=80))
&& (!data.keys().hasAny(['pinLoginEnabled'])||data.pinLoginEnabled is bool)
&& (!data.keys().hasAny(['failedLoginCount'])||data.failedLoginCount is int);
}
function validStaffWorkspaceProfile(data,uid) {
return data.uid==uid
&& data.userId==uid
&& data.staffId==uid
&& data.workspaceId is string
&& data.workspaceId.size()>0
&& data.workspaceId.size()<=128
&& data.workspaceId!=uid
&& data.ownerId==data.workspaceId
&& data.email is string
&& data.email.size()>3
&& data.email.size()<=254;
}
function validStaffRoleProfile(data) {
return data.role is string
&& !isOwnerRole(data.role)
&& !(data.role in ['superadmin','Superadmin','SUPERADMIN'])
&& data.status in ['active','blocked','disabled','inactive','Active','Blocked','Disabled','Inactive']
&& data.emailVerifiedCustom==true
&& data.onboardingCompleted==true;
}
function validStaffBooleanFlags(data) {
return (!data.keys().hasAny(['authCreated'])||data.authCreated is bool)
&& (!data.keys().hasAny(['isStaff'])||data.isStaff==true)
&& (!data.keys().hasAny(['isOwner'])||data.isOwner==false)
&& (!data.keys().hasAny(['isAdmin'])||data.isAdmin==false);
}
function validStaffUserProfile(data,uid) {
return validStaffUserProfileFields(data)
&& validStaffLoginProfileFields(data)
&& validStaffWorkspaceProfile(data,uid)
&& validStaffRoleProfile(data)
&& validStaffBooleanFlags(data);
}
function adminCanWriteStaffUser(uid) {
return signedIn()
&& request.resource.data.workspaceId is string
&& workspaceAdmin(request.resource.data.workspaceId)
&& validStaffUserProfile(request.resource.data,uid);
}
function adminCanReadStaffUser() {
return signedIn()
&& resource.data.workspaceId is string
&& workspaceAdmin(resource.data.workspaceId)
&& !isOwnerRole(resource.data.get('role',''));
}
function ownerSelfUserUpdateSafe() {
return isOwnerRole(resource.data.get('role','owner'))
&& !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid','userId','ownerId','workspaceId','role','isAdmin','plan','planStatus','subscriptionStatus','billingCycle','trialStartAt','trialStartedAt','trialEndsAt','isTrialActive','expiresAt']);
}
function staffSelfUserUpdateSafe() {
return !isOwnerRole(resource.data.get('role','owner'))
&& !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid','userId','staffId','ownerId','companyId','workspaceId','role','isAdmin','permissions','businessPermissions','businessType','selectedBusinessType','currentBusinessType','primaryBusinessType','allowedBusinessTypes','selectedWorkspace','enabledModules','plan','planStatus','subscriptionStatus','billingCycle','trialStartAt','trialStartedAt','trialEndsAt','isTrialActive','expiresAt']);
}
function selfUserUpdateSafe(uid) {
return signedIn()
&& request.auth.uid==uid
&& (ownerSelfUserUpdateSafe()||staffSelfUserUpdateSafe());
}
match /users/{uid} {
allow create: if (signedIn()&&request.auth.uid==uid)
|| adminCanWriteStaffUser(uid);
allow read: if backendAdmin()||(signedIn()&&request.auth.uid==uid)||adminCanReadStaffUser();
allow update: if backendAdmin()
|| (paymentWorker()&&validPaymentUserUpdate(uid))
|| adminCanWriteStaffUser(uid)
|| selfUserUpdateSafe(uid);
allow delete: if backendAdmin();
match /{subPath=**} {
allow read,write: if backendAdmin()||(signedIn()&&request.auth.uid==uid);
}
}
match /staffInviteClaims/{uid} {
allow read: if backendAdmin()
|| (signedIn()&&request.auth.uid==uid)
|| (signedIn()&&resource.data.workspaceId is string&&workspaceAdmin(resource.data.workspaceId));
allow create,update: if adminCanWriteStaffUser(uid);
allow delete: if backendAdmin()
|| (signedIn()&&resource.data.workspaceId is string&&workspaceAdmin(resource.data.workspaceId));
}
match /staffInviteEmails/{emailKey} {
allow read: if backendAdmin()
|| (signedIn()&&resource.data.email is string&&('email' in request.auth.token)&&request.auth.token.email==resource.data.email)
|| (signedIn()&&resource.data.workspaceId is string&&workspaceAdmin(resource.data.workspaceId));
allow create,update: if signedIn()
&& request.resource.data.uid is string
&& adminCanWriteStaffUser(request.resource.data.uid);
allow delete: if backendAdmin()
|| (signedIn()&&resource.data.workspaceId is string&&workspaceAdmin(resource.data.workspaceId));
}
