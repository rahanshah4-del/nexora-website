allow update: if canManageWorkspace(workspaceId)&&safeUpdate(workspaceId)&&ownerMemberWriteSafe(workspaceId,staffId);
allow delete: if canManageWorkspace(workspaceId)&&!ownerMemberResource(workspaceId,staffId);
