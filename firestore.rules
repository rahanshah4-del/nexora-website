// permissions aren't wired into Team Management UI yet, so only
// owner/admin can create/edit/delete branches for now (via workspaceAdmin
// inside canCreateModule/canEditModule/canDeleteModule) until that lands.
match /branches/{docId} {
allow read: if canReadModule(workspaceId,'branches');
allow create: if canCreateModule(workspaceId,'branches')&&safeCreate(workspaceId);
allow update: if canEditModule(workspaceId,'branches')&&safeUpdate(workspaceId);
allow delete: if canDeleteModule(workspaceId,'branches');
}
match /customers/{docId} {
allow read: if canReadModule(workspaceId,'customers')||canReadModule(workspaceId,'pos')||canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'transportCustomers');
