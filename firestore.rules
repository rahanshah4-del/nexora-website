	match /restaurantRecipes/{docId} {
	allow read: if canReadModule(workspaceId,'kitchenProduction')||canReadModule(workspaceId,'menuManagement');
	allow create: if canCreateModule(workspaceId,'kitchenProduction')&&safeCreate(workspaceId);
	allow update: if canEditModule(workspaceId,'kitchenProduction')&&safeUpdate(workspaceId);
	allow delete: if canDeleteModule(workspaceId,'kitchenProduction');
	}
	match /restaurantDeductions/{docId} {
	allow read: if canReadModule(workspaceId,'kitchenProduction')||canReadModule(workspaceId,'orders');
	allow create: if canCreateModule(workspaceId,'kitchenProduction')&&safeCreate(workspaceId);
	allow update: if false;
	allow delete: if false;
	}
	match /restaurantWaste/{docId} {
	allow read: if canReadModule(workspaceId,'kitchenProduction');
	allow create: if canCreateModule(workspaceId,'kitchenProduction')&&safeCreate(workspaceId);
	allow update: if workspaceAdmin(workspaceId);
	allow delete: if workspaceAdmin(workspaceId);
	}
	match /restaurantCashSessions/{docId} {
	allow read: if canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'approvals');
	allow create: if canCreateModule(workspaceId,'orders')&&safeCreate(workspaceId);
	allow update: if canEditModule(workspaceId,'orders')&&safeUpdate(workspaceId);
	allow delete: if false;
	}
	match /restaurantPayments/{docId} {
	allow read: if canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'invoices');
	allow create: if canCreateModule(workspaceId,'orders')&&safeCreate(workspaceId);
	allow update: if canEditModule(workspaceId,'orders')&&safeUpdate(workspaceId);
	allow delete: if false;
	}
	match /restaurantRefunds/{docId} {
	allow read: if canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'invoices');
	allow create: if canCreateModule(workspaceId,'orders')&&safeCreate(workspaceId);
	allow update: if canEditModule(workspaceId,'orders')&&safeUpdate(workspaceId);
	allow delete: if false;
	}
	match /restaurantCashMovements/{docId} {
	allow read: if canReadModule(workspaceId,'orders');
	allow create: if canCreateModule(workspaceId,'orders')&&safeCreate(workspaceId);
	allow update: if false;
	allow delete: if false;
	}
	match /menuItems/{docId} {
	allow read: if canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'ordersKot')||canReadModule(workspaceId,'menuManagement');
	allow create: if canCreateModule(workspaceId,'menuManagement')&&safeCreate(workspaceId);
	allow update: if canEditModule(workspaceId,'menuManagement')&&safeUpdate(workspaceId);
	allow delete: if canDeleteModule(workspaceId,'menuManagement');
	}
	match /tables/{docId} {
	allow read: if canReadModule(workspaceId,'tables')||canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'ordersKot')||canReadModule(workspaceId,'reservations');
	allow create: if canCreateModule(workspaceId,'tables')&&safeCreate(workspaceId);
	allow update: if canEditModule(workspaceId,'tables')&&safeUpdate(workspaceId);
	allow delete: if canDeleteModule(workspaceId,'tables');
	}
	match /orders/{orderId} {
	allow read: if canReadModule(workspaceId,'orders')||canReadModule(workspaceId,'ordersKot')||canReadModule(workspaceId,'posOrders');
	allow create: if canCreateModule(workspaceId,'orders')&&safeCreate(workspaceId);
	allow update: if canEditModule(workspaceId,'orders')&&safeUpdate(workspaceId);
	allow delete: if false;
	}
}
match /upgradeRequests/{requestId} {
allow create: if backendAdmin()||(activeSignedIn()&&request.resource.data.userId==request.auth.uid);
allow read: if backendAdmin()||paymentWorker()||(activeSignedIn()&&resource.data.userId==request.auth.uid);
allow update: if backendAdmin()||validPaymentRequestUpdate();
allow delete: if backendAdmin();
match /timeline/{timelineId} {
allow read: if backendAdmin()
|| paymentWorker()
|| (
activeSignedIn()
&& get(/databases/$(database)/documents/upgradeRequests/$(requestId)).data.userId==request.auth.uid
);
allow create: if backendAdmin()
|| (
activeSignedIn()
&& get(/databases/$(database)/documents/upgradeRequests/$(requestId)).data.userId==request.auth.uid
&& request.resource.data.actor=='client'
&& request.resource.data.message is string
&& request.resource.data.message.size()>0
&& request.resource.data.message.size()<=2000
&& request.resource.data.createdAt is timestamp
);
allow update,delete: if false;
}
}
match /platformSettings/{docId} {
allow read: if true;
allow write: if backendAdmin();
}
match /platformPlans/{docId} {
allow read: if true;
allow write: if backendAdmin();
}
match /promoCodes/{promoId} {
allow get: if paymentWorker()||(
activeSignedIn()
&& resource.data.active==true
&& resource.data.startsAt<=request.time
&& resource.data.expiresAt>request.time
&& (resource.data.usageLimit==0||resource.data.usedCount<resource.data.usageLimit)
);
allow list: if backendAdmin();
allow create: if backendAdmin()
&& validPromoCode(request.resource.data,promoId)
&& request.resource.data.createdAt==request.time
&& request.resource.data.updatedAt==request.time
&& request.resource.data.createdBy==request.auth.uid
&& request.resource.data.updatedBy==request.auth.uid
&& request.resource.data.usedCount==0;
allow update: if (
backendAdmin()
&& validPromoCode(request.resource.data,promoId)
&& request.resource.data.code==resource.data.code
&& request.resource.data.createdAt==resource.data.createdAt
&& request.resource.data.createdBy==resource.data.createdBy
&& request.resource.data.updatedAt>=request.time - duration.value(5,'m')
&& request.resource.data.updatedAt<=request.time + duration.value(5,'m')
&& request.resource.data.updatedBy==request.auth.uid
)||(
paymentWorker()
&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount','updatedAt'])
&& request.resource.data.usedCount==resource.data.usedCount + 1
&& request.resource.data.updatedAt>=request.time - duration.value(5,'m')
&& request.resource.data.updatedAt<=request.time + duration.value(5,'m')
&& (resource.data.usageLimit==0||request.resource.data.usedCount<=resource.data.usageLimit)
);
allow delete: if backendAdmin();
}
match /whatsappPricing/{docId} {
allow read: if true;
allow write: if backendAdmin();
}
match /platformPayments/{docId} {
allow read: if backendAdmin();
allow create,update: if backendAdmin()||validPlatformPaymentWrite();
allow delete: if backendAdmin();
}
match /platformSubscriptions/{docId} {
allow read,write: if backendAdmin();
}
match /marketingSubscribers/{docId} {
allow read,write: if marketingAdmin();
}
match /marketingCampaigns/{docId} {
allow read,write: if marketingAdmin();
}
match /marketingEmailLogs/{docId} {
allow read,write: if marketingAdmin();
}
match /announcements/{docId} {
allow read: if true;
allow write: if backendAdmin();
}
match /blogPosts/{slug} {
allow read: if backendAdmin()||resource.data.status=='published';
allow create,update: if backendAdmin()
&& request.resource.data.slug==slug
&& validBlogPost(request.resource.data);
allow delete: if backendAdmin();
}
function validBlogComment(data) {
return data.keys().hasAll(['slug','authorName','comment','status','pinned','isTeamReply','helpful','reported','createdAt','updatedAt'])
&& data.keys().hasOnly(['slug','parentId','authorName','authorEmail','comment','rating','status','pinned','isTeamReply','helpful','reported','createdAt','updatedAt'])
&& data.slug is string
&& data.slug.matches('^[a-z0-9-]{3,120}$')
&& (!('parentId' in data)||data.parentId is string)
&& data.authorName is string
&& data.authorName.size()>0
&& data.authorName.size()<=80
&& data.comment is string
&& data.comment.size()>=2
&& data.comment.size()<=2000
&& (!('rating' in data)||(data.rating is number&&data.rating>=1&&data.rating<=5))
&& data.status=='pending'
&& data.pinned==false
&& data.isTeamReply==false
&& data.helpful is list
&& data.reported==false
&& data.createdAt is timestamp
&& data.updatedAt is timestamp;
}
function validBlogCommentUpdate(data) {
return data.diff(resource.data).affectedKeys().hasOnly(['status','pinned','isTeamReply','helpful','reported','updatedAt']);
}
match /blogComments/{commentId} {
allow read: if resource.data.status in ['approved','pending'];
allow create: if validBlogComment(request.resource.data);
allow update: if backendAdmin()&&validBlogCommentUpdate(request.resource.data);
allow delete: if backendAdmin();
}
match /blogLikes/{slug} {
    allow read: if true;
    allow create: if request.resource.data.keys().hasOnly(['slug','likes','dislikes','updatedAt'])
      && request.resource.data.slug == slug
      && request.resource.data.likes is number
      && request.resource.data.dislikes is number;
    allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','dislikes','updatedAt'])
      && request.resource.data.likes is number
      && request.resource.data.dislikes is number
      && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1 || request.resource.data.likes == resource.data.likes)
      && (request.resource.data.dislikes == resource.data.dislikes + 1 || request.resource.data.dislikes == resource.data.dislikes - 1 || request.resource.data.dislikes == resource.data.dislikes);
  }
  match /blogTranslations/{slug} {
    allow read: if true;
    allow create, update: if backendAdmin();
    allow delete: if backendAdmin();
  }
  match /blogBackups/{backupId} {
    allow read: if backendAdmin();
    allow create, update: if backendAdmin();
    allow delete: if backendAdmin();
  }
  match /blogViews/{slug} {
allow read: if true;
allow create: if request.resource.data.keys().hasOnly(['slug','count','updatedAt'])
&& request.resource.data.slug==slug
&& request.resource.data.count==1
&& request.resource.data.updatedAt is timestamp;
allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','updatedAt'])
&& request.resource.data.count==resource.data.count+1
&& request.resource.data.count is number
&& request.resource.data.count>=1
&& request.resource.data.updatedAt is timestamp;
}
match /businessServices/{docId} {
allow read: if true;
allow create,update: if backendAdmin()&&validBusinessService(request.resource.data);
allow delete: if backendAdmin();
}
match /businessServiceRequests/{docId} {
allow create: if validBusinessServiceRequest(request.resource.data);
allow read: if backendAdmin()||businessServiceRequestMember();
allow delete: if backendAdmin();
allow update: if (backendAdmin()&&validBusinessServiceRequestStatusUpdate(request.resource.data))
|| validBusinessServiceRequestClientCommentUpdate(request.resource.data);
match /timeline/{timelineId} {
allow read: if backendAdmin()||businessServiceRequestParentMember(docId);
allow create: if (backendAdmin()||businessServiceRequestParentMember(docId))
&& validBusinessServiceRequestTimeline(request.resource.data);
allow update,delete: if false;
}
match /comments/{commentId} {
allow read: if backendAdmin()||businessServiceRequestParentMember(docId);
allow create: if businessServiceRequestParentMember(docId)
&& validBusinessServiceRequestComment(request.resource.data);
allow update,delete: if false;
}
}
match /supportTickets/{docId} {
allow create: if activeSignedIn();
allow read,update,delete: if backendAdmin()||(activeSignedIn()&&resource.data.createdBy==request.auth.uid);
}
match /backendStaff/{docId} {
allow read,write: if backendAdmin();
}
match /backendActivityLogs/{docId} {
allow read,write: if backendAdmin();
}
match /analyticsEvents/{docId} {
allow create: if signedIn() && validAnalyticsEvent();
allow read,update,delete: if backendAdmin();
}
match /userSessions/{docId} {
allow create: if activeSignedIn()&&request.resource.data.userId==request.auth.uid;
allow read,update,delete: if backendAdmin()||(activeSignedIn()&&resource.data.userId==request.auth.uid);
}
match /{document=**} {
allow read,write: if backendAdmin();
}
}
}
