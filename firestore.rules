allow read: if isAdmin()||resource.data.status=='published';
allow create,update: if isAdmin()
&& request.resource.data.slug==slug
&& validBlogPost(request.resource.data);
allow delete: if isAdmin();
}
function validBlogComment(data) {
return data.keys().hasAll(['slug','authorName','comment','status','pinned','isTeamReply','helpful','reported','createdAt','updatedAt'])
&& data.keys().hasOnly(['slug','parentId','authorName','authorEmail','comment','rating','status','pinned','isTeamReply','helpful','reported','createdAt','updatedAt'])
&& data.slug is string
&& data.slug.matches('^[a-z0-9-]{3,120}$')
&& (!('parentId' in data)||data.parentId is string)
&& data.authorName is string
&& data.authorName.size()>0
&& data.authorName.size()<=80
&& data.comment is string
&& data.comment.size()>=2
&& data.comment.size()<=2000
&& (!('rating' in data)||(data.rating is number&&data.rating>=1&&data.rating<=5))
&& data.status=='pending'
&& data.pinned==false
&& data.isTeamReply==false
&& data.helpful is list
&& data.reported==false
&& data.createdAt is timestamp
&& data.updatedAt is timestamp;
}
function validBlogCommentUpdate(data) {
return data.diff(resource.data).affectedKeys().hasOnly(['status','pinned','isTeamReply','helpful','reported','updatedAt']);
}
match /blogComments/{commentId} {
allow read: if resource.data.status in ['approved','pending'];
allow create: if validBlogComment(request.resource.data);
allow update: if isAdmin()&&validBlogCommentUpdate(request.resource.data);
allow delete: if isAdmin();
}
match /blogLikes/{slug} {
    allow read: if true;
    allow create: if request.resource.data.keys().hasOnly(['slug','likes','dislikes','updatedAt'])
      && request.resource.data.slug == slug
      && request.resource.data.likes is number
      && request.resource.data.dislikes is number;
    allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','dislikes','updatedAt'])
      && request.resource.data.likes is number
      && request.resource.data.dislikes is number
      && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1 || request.resource.data.likes == resource.data.likes)
      && (request.resource.data.dislikes == resource.data.dislikes + 1 || request.resource.data.dislikes == resource.data.dislikes - 1 || request.resource.data.dislikes == resource.data.dislikes);
  }
  match /blogTranslations/{slug} {
    allow read: if true;
    allow create, update: if isAdmin();
    allow delete: if isAdmin();
  }
  // Old slug -> new slug for renamed published posts, written by the blog CMS.
  // Public read: the site build reads it to generate 301s.
  match /blogRedirects/{fromSlug} {
    allow read: if true;
    allow create, update: if isAdmin()
      && request.resource.data.keys().hasOnly(['from','to','createdAt','createdBy'])
      && request.resource.data.from == fromSlug
      && fromSlug.matches('^[a-z0-9-]{3,120}$')
      && request.resource.data.to is string
      && request.resource.data.to.matches('^[a-z0-9-]{3,120}$')
      && request.resource.data.to != fromSlug;
    allow delete: if isAdmin();
  }

  // Legacy: nothing writes blogBackups any more (see saveBlogTranslationsToFirestore
  // in src/lib/blogTranslate.js). Rules kept admin-only so the leftover documents can
  // still be listed and cleaned up.
  match /blogBackups/{backupId} {
    allow read: if isAdmin();
    allow create, update: if isAdmin();
    allow delete: if isAdmin();
  }
  match /blogViews/{slug} {
allow read: if true;
allow create: if request.resource.data.keys().hasOnly(['slug','count','updatedAt'])
&& request.resource.data.slug==slug
&& request.resource.data.count==1
&& request.resource.data.updatedAt is timestamp;
allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','updatedAt'])
&& request.resource.data.count==resource.data.count+1
&& request.resource.data.count is number
&& request.resource.data.count>=1
&& request.resource.data.updatedAt is timestamp;
}
match /businessServices/{docId} {
allow read: if true;
allow create,update: if isAdmin()&&validBusinessService(request.resource.data);
allow delete: if isAdmin();
}
match /businessServiceRequests/{docId} {
allow create: if validBusinessServiceRequest(request.resource.data);
allow read: if isAdmin()||businessServiceRequestMember();
allow delete: if isAdmin();
allow update: if (isAdmin()&&validBusinessServiceRequestStatusUpdate(request.resource.data))
|| validBusinessServiceRequestClientCommentUpdate(request.resource.data);
match /timeline/{timelineId} {
allow read: if isAdmin()||businessServiceRequestParentMember(docId);
allow create: if (isAdmin()||businessServiceRequestParentMember(docId))
&& validBusinessServiceRequestTimeline(request.resource.data);
allow update,delete: if false;
}
match /comments/{commentId} {
allow read: if isAdmin()||businessServiceRequestParentMember(docId);
allow create: if businessServiceRequestParentMember(docId)
&& validBusinessServiceRequestComment(request.resource.data);
allow update,delete: if false;
}
}
match /supportTickets/{docId} {
allow create: if activeSignedIn();
allow read,update,delete: if isAdmin()||(activeSignedIn()&&resource.data.createdBy==request.auth.uid);
}
match /backendStaff/{docId} {
allow read,write: if isAdmin();
}
match /backendActivityLogs/{docId} {
allow read,write: if isAdmin();
}
// AI blog knowledge, written by src/lib/blogKnowledge.js on blog publish:
//   aiKnowledge/index             — global search index
//   aiKnowledge/blogs/items/{slug} — one document per post
// The recursive wildcard covers both. Ingestion runs client-side from the
// Control Centre, which is gated on the same backendAdmin allowlist
// (src/lib/roles.js), so no wider access is needed; the public AI chat reads
// this knowledge from the AI Gateway KV, not from Firestore.
match /aiKnowledge/{docId=**} {
allow read,write: if isAdmin();
}
match /analyticsEvents/{docId} {
allow create: if signedIn() && validAnalyticsEvent();
allow read,update,delete: if isAdmin();
}
match /userSessions/{docId} {
allow create: if activeSignedIn()&&request.resource.data.userId==request.auth.uid;
allow read,update,delete: if isAdmin()||(activeSignedIn()&&resource.data.userId==request.auth.uid);
}

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    match /comments/{commentId} {
      allow read: if resource.data.approved == true;
      allow create: if request.resource.data.approved == false
        && request.resource.data.articleSlug is string
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000;
      allow update, delete: if isAdmin();
    }


    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminUsers/{userId} {
      allow read, write: if isAdmin();
    }

  match /submissions/{submissionId} {
    allow read: if resource.data.status == 'approved' || isAdmin();
    allow create: if request.resource.data.status == 'pending'
      && request.resource.data.siteName is string
      && request.resource.data.siteName.size() > 0
      && request.resource.data.siteName.size() <= 100
      && request.resource.data.url is string
      && request.resource.data.url.size() > 0
      && request.resource.data.url.size() <= 500
      && request.resource.data.category is string
      && request.resource.data.category.size() > 0
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 200
      && request.resource.data.submitterEmail is string
      && request.resource.data.submitterEmail.size() > 0
      && request.resource.data.submitterEmail.size() <= 254
      && request.resource.data.slug is string
      && request.resource.data.slug.size() > 0;
    allow update, delete: if isAdmin();
  }

  match /analytics/{eventId} {
    allow read: if isAdmin();
    allow create: if request.resource.data.keys().hasOnly([
      'ts', 'day', 'hour', 'path', 'slug', 'title', 'vid', 'sid',
      'isNew', 'visitCount', 'duration', 'referrer', 'device',
      'country', 'browser'
    ])
      && request.resource.data.path is string
      && request.resource.data.path.size() > 0
      && request.resource.data.path.size() <= 300
      && request.resource.data.vid is string
      && request.resource.data.vid.size() <= 64
      && request.resource.data.sid is string
      && request.resource.data.sid.size() <= 64
      && request.resource.data.isNew is bool
      && request.resource.data.duration is int
      && request.resource.data.duration >= 0
      && request.resource.data.duration <= 3600
      && request.resource.data.hour is int
      && request.resource.data.hour >= 0
      && request.resource.data.hour <= 23;
    allow update: if false;
    allow delete: if isAdmin();
  }

match /{document=**} {
allow read,write: if isAdmin();
}

    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
}
}



