rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function memberWorkspaceId() {
      return profile().workspaceId;
    }

    function memberRole() {
      return profile().role;
    }

    function permissionDocId() {
      return profile().staffId is string ? profile().staffId : request.auth.uid;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() && memberWorkspaceId() == workspaceId;
    }

    function isWorkspaceManager(workspaceId) {
      return isSelf(workspaceId)
        || isAdmin()
        || (isWorkspaceMember(workspaceId) && memberRole() in ['owner', 'admin']);
    }

    function isPaymentApprover(workspaceId) {
      return isSelf(workspaceId)
        || isAdmin()
        || (isWorkspaceMember(workspaceId) && memberRole() in ['owner', 'admin', 'accountant']);
    }

    function paymentApprovalFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus',
        'status',
        'paidAt',
        'approvedBy',
        'amountPaid',
        'partialPaidAmount',
        'balanceDue',
        'lastPaymentAt',
        'lastPaymentBy',
        'rejectedAt',
        'rejectedBy',
        'cancelledAt',
      ]);
    }

    function paymentReferenceFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'paymentStatus',
        'status',
        'paymentSubmittedAt',
        'paymentSubmittedBy',
        'lastPaymentReference',
        'ownerId',
        'userId',
        'workspaceId',
        'updatedAt',
      ])
      && request.resource.data.paymentStatus == 'pending_verification'
      && request.resource.data.paymentSubmittedBy == request.auth.uid;
    }

    function canReadClientPortalInvoice(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && (
          resource.data.customerEmail == profile().email
          || resource.data.clientId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
          || isSelf(workspaceId)
        );
    }

    function canReadClientPortalPayment(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && (
          resource.data.submittedBy == request.auth.uid
          || resource.data.approvedBy == request.auth.uid
          || resource.data.clientId == request.auth.uid
          || isSelf(workspaceId)
        );
    }

    function canSubmitPaymentReference(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && request.resource.data.paymentStatus == 'pending_verification'
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.ownerId == workspaceId
        && request.resource.data.userId == workspaceId
        && request.resource.data.workspaceId == workspaceId;
    }

    function staffPermission(workspaceId, key) {
      return isWorkspaceManager(workspaceId)
        || (isWorkspaceMember(workspaceId)
          && get(/databases/$(database)/documents/workspaces/$(workspaceId)/permissions/$(permissionDocId())).data[key] == true);
    }

    function hasOwnScope(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.ownerId == userId
        && request.resource.data.workspaceId == userId;
    }

    function hasSafeTrialPlan() {
      return (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan in ['Free', 'Basic'])
        && (!request.resource.data.keys().hasAny(['planStatus']) || request.resource.data.planStatus in ['trial', 'Free Plan', 'inactive'])
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['owner', 'user'])
        && (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false);
    }

    function protectedAccountFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'planStatus',
        'billingCycle',
        'role',
        'isAdmin',
        'upgradedAt',
        'trialStartedAt',
      ]);
    }

    function isCreatingStaffUser(userId) {
      return signedIn()
        && request.resource.data.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.workspaceId is string
        && request.resource.data.ownerId == request.resource.data.workspaceId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.role in ['staff', 'admin', 'accountant']
        && isWorkspaceManager(request.resource.data.workspaceId);
    }

    match /users/{userId} {
      allow create: if isAdmin()
        || isCreatingStaffUser(userId)
        || (isSelf(userId)
          && request.resource.data.uid == userId
          && hasOwnScope(userId)
          && hasSafeTrialPlan());
      allow read: if isSelf(userId) || isAdmin();
      allow update: if isAdmin() || (isSelf(userId) && protectedAccountFieldsUnchanged());
      allow delete: if isAdmin();

      match /sessions/{sessionId} {
        allow create: if isSelf(userId)
          && request.resource.data.userId == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.workspaceId == userId;
        allow read: if isSelf(userId) || isAdmin();
        allow update: if isAdmin()
          || (isSelf(userId)
            && resource.data.userId == userId
            && request.resource.data.userId == userId
            && request.resource.data.ownerId == userId
            && request.resource.data.workspaceId == userId);
        allow delete: if isAdmin();
      }
    }

    match /workspaces/{workspaceId} {
      allow create: if isAdmin()
        || (isSelf(workspaceId)
          && hasOwnScope(workspaceId)
          && hasSafeTrialPlan());
      allow read: if isSelf(workspaceId) || isAdmin();
      allow update: if isAdmin() || (isSelf(workspaceId) && protectedAccountFieldsUnchanged());
      allow delete: if isAdmin();

      match /tasks/{taskId} {
        allow read: if isWorkspaceMember(workspaceId) || isWorkspaceManager(workspaceId);
        allow create: if staffPermission(workspaceId, 'followUpEdit');
        allow update: if staffPermission(workspaceId, 'followUpEdit');
        allow delete: if staffPermission(workspaceId, 'followUpDelete');
      }

      match /staff/{staffId} {
        allow read: if isWorkspaceManager(workspaceId)
          || staffPermission(workspaceId, 'reports')
          || (isWorkspaceMember(workspaceId)
            && (resource.data.userId == request.auth.uid || resource.data.staffId == permissionDocId()));
        allow create, update, delete: if staffPermission(workspaceId, 'settingsAccess');
      }

      match /permissions/{staffId} {
        allow read: if isWorkspaceManager(workspaceId) || (isWorkspaceMember(workspaceId) && staffId == permissionDocId());
        allow create, update, delete: if staffPermission(workspaceId, 'settingsAccess');
      }

      match /customers/{customerId} {
        allow read: if staffPermission(workspaceId, 'customerManagement') || staffPermission(workspaceId, 'reports');
        allow write: if staffPermission(workspaceId, 'customerManagement');
      }

      match /clients/{clientId} {
        allow read, write: if isWorkspaceManager(workspaceId);
      }

      match /products/{productId} {
        allow read: if staffPermission(workspaceId, 'invoices') || staffPermission(workspaceId, 'reports');
        allow write: if isWorkspaceManager(workspaceId);
      }

      match /leads/{leadId} {
        allow read: if staffPermission(workspaceId, 'leadsManagement') || staffPermission(workspaceId, 'reports');
        allow write: if staffPermission(workspaceId, 'leadsManagement');
      }

      match /invoices/{invoiceId} {
        allow read: if staffPermission(workspaceId, 'invoices')
          || staffPermission(workspaceId, 'reports')
          || isPaymentApprover(workspaceId)
          || canReadClientPortalInvoice(workspaceId);
        allow create: if staffPermission(workspaceId, 'invoices');
        allow update: if (staffPermission(workspaceId, 'invoices') && !paymentApprovalFieldsTouched())
          || (isPaymentApprover(workspaceId) && paymentApprovalFieldsTouched())
          || (isWorkspaceMember(workspaceId) && paymentReferenceFieldsTouched());
        allow delete: if staffPermission(workspaceId, 'invoices');
      }

      match /payments/{paymentId} {
        allow read: if staffPermission(workspaceId, 'invoices')
          || staffPermission(workspaceId, 'reports')
          || isPaymentApprover(workspaceId)
          || canReadClientPortalPayment(workspaceId);
        allow create: if isPaymentApprover(workspaceId) || canSubmitPaymentReference(workspaceId);
        allow update, delete: if isWorkspaceManager(workspaceId);
      }

      match /pipelines/{dealId} {
        allow read: if staffPermission(workspaceId, 'reports') || staffPermission(workspaceId, 'leadsManagement');
        allow write: if isWorkspaceManager(workspaceId);
      }

      match /supportTickets/{ticketId} {
        allow read: if staffPermission(workspaceId, 'reports');
        allow write: if isWorkspaceManager(workspaceId);
      }

      match /subscriptions/{subscriptionId} {
        allow read: if staffPermission(workspaceId, 'reports');
        allow write: if isWorkspaceManager(workspaceId);
      }

      match /activityLogs/{logId} {
        allow read: if staffPermission(workspaceId, 'reports');
        allow create: if (isSelf(workspaceId) || isWorkspaceMember(workspaceId))
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.ownerId == workspaceId
          && request.resource.data.workspaceId == workspaceId;
        allow update, delete: if isWorkspaceManager(workspaceId);
      }

      match /teamMembers/{memberId} {
        allow read: if staffPermission(workspaceId, 'reports') || staffPermission(workspaceId, 'settingsAccess');
        allow write: if staffPermission(workspaceId, 'settingsAccess');
      }

      match /hr/{employeeId} {
        allow read, write: if staffPermission(workspaceId, 'hrDashboard');
      }

      match /teamPermissions/{permissionId} {
        allow read, write: if staffPermission(workspaceId, 'settingsAccess');
      }

      match /{document=**} {
        allow read, write: if isSelf(workspaceId) || isAdmin();
      }
    }

    match /upgradeRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.workspaceId == request.auth.uid
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.paymentStatus == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
