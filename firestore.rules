match /salesDeals/{docId} {
allow read: if canReadModule(workspaceId,'salesPipeline')||canReadModule(workspaceId,'deals');
allow create: if (canCreateModule(workspaceId,'salesPipeline')||canCreateModule(workspaceId,'deals'))&&safeCreate(workspaceId);
allow update: if (canEditModule(workspaceId,'salesPipeline')||canEditModule(workspaceId,'deals'))&&safeUpdate(workspaceId);
allow delete: if canDeleteModule(workspaceId,'deals')||canDeleteModule(workspaceId,'salesPipeline');
}
match /salesTasks/{docId} {
allow read: if canReadModule(workspaceId,'tasks')||canReadModule(workspaceId,'followUps')||canReadModule(workspaceId,'whatsappFollowUps');
allow create: if (canCreateModule(workspaceId,'tasks')||canCreateModule(workspaceId,'followUps')||canCreateModule(workspaceId,'whatsappFollowUps'))&&safeCreate(workspaceId);
allow update: if (canEditModule(workspaceId,'tasks')||canEditModule(workspaceId,'followUps')||canEditModule(workspaceId,'whatsappFollowUps'))&&safeUpdate(workspaceId);
allow delete: if canDeleteModule(workspaceId,'tasks')||canDeleteModule(workspaceId,'followUps');
}
match /salesActivities/{docId} {
allow read: if canReadModule(workspaceId,'activities');
allow create: if canCreateModule(workspaceId,'activities')&&safeCreate(workspaceId);
allow update: if canEditModule(workspaceId,'activities')&&safeUpdate(workspaceId);
allow delete: if canDeleteModule(workspaceId,'activities');
}
match /salesQuotes/{docId} {
allow read: if canReadModule(workspaceId,'quotations');
allow create: if canCreateModule(workspaceId,'quotations')&&safeCreate(workspaceId);
allow update: if canEditModule(workspaceId,'quotations')&&safeUpdate(workspaceId);
allow delete: if canDeleteModule(workspaceId,'quotations');
}
match /salesProducts/{docId} {
allow read: if canReadModule(workspaceId,'salesProducts')||canReadModule(workspaceId,'products');
allow create: if (canCreateModule(workspaceId,'salesProducts')||canCreateModule(workspaceId,'products'))&&safeCreate(workspaceId);
allow update: if (canEditModule(workspaceId,'salesProducts')||canEditModule(workspaceId,'products'))&&safeUpdate(workspaceId);
