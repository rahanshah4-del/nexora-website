rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Platform admins by Firebase Auth UID, never by email. Same list as
    // isAdmin() in firestore.rules (tests/rules/admin-uids.test.mjs).
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['REPLACE_WITH_ADMIN_UID'];
    }

    function validBlogImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validMenuImportFile() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    match /public-blog/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validBlogImage();
      allow delete: if isAdmin();
    }

    match /menuImports/{workspaceId}/{allPaths=**} {
      allow read: if signedIn();
      allow create: if signedIn() && validMenuImportFile();
      allow delete: if signedIn() && request.auth.uid == workspaceId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
