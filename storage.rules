rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function backendAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['admin@nexora.com', 'rahanshah2@gmail.com', 'farhanshah2@gmail.com'];
    }

    function validBlogImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validMenuImportFile() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    match /public-blog/{allPaths=**} {
      allow read: if true;
      allow create, update: if backendAdmin() && validBlogImage();
      allow delete: if backendAdmin();
    }

    match /menuImports/{workspaceId}/{allPaths=**} {
      allow read: if signedIn();
      allow create: if signedIn() && validMenuImportFile();
      allow delete: if signedIn() && request.auth.uid == workspaceId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
