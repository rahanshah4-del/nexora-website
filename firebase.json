{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/services",
        "destination": "/business-services/",
        "type": 301
      },
      {
        "source": "/services/",
        "destination": "/business-services/",
        "type": 301
      },
      {
        "source": "/solutions/pos",
        "destination": "/restaurant-pos/",
        "type": 301
      },
      {
        "source": "/solutions/pos/",
        "destination": "/restaurant-pos/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/check-admin-uids.mjs\""
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/check-admin-uids.mjs\""
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/check-admin-uids.mjs\""
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "tasks": {
      "port": 9499
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
