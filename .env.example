# ── Paddle ──
# Client-side token from Paddle Dashboard → Developer Tools → Client-side tokens
# Sandbox tokens: test_... | Live tokens: live_...
VITE_PADDLE_CLIENT_TOKEN=
# "sandbox" or "production"
VITE_PADDLE_ENVIRONMENT=sandbox
# Payments worker base URL
VITE_PAYMENTS_WORKER_URL=https://nexora-payments-api.rahanshah4.workers.dev

# GeoLint audit engine (Cloud Run URL of geolint-backend, no trailing slash). Used by Control Centre > GeoLint Audits.
VITE_GEOLINT_API_URL=

# Show the card checkout option on the upgrade page (Lemon Squeezy). Keep false until the store is live.
VITE_LEMONSQUEEZY_ENABLED=false

# Show the Polar card checkout option on the upgrade page (takes the card slot over Lemon Squeezy). Keep false until Polar is live.
VITE_POLAR_ENABLED=false
