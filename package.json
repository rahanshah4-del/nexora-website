{
  "name": "nexora-website-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender.mjs",
    "audit:sales-hub": "node scripts/audit-sales-hub-calculations.mjs",
    "audit:retail-pos": "node scripts/audit-retail-pos-calculations.mjs",
    "audit:school-erp": "node scripts/audit-school-erp-calculations.mjs",
    "audit:restaurant-pos": "node scripts/audit-restaurant-pos-calculations.mjs",
    "audit:transport-rental": "node scripts/audit-transport-rental-calculations.mjs",
    "audit:property-erp": "node scripts/audit-property-erp-calculations.mjs",
    "audit:whatsapp-crm": "node scripts/audit-whatsapp-crm-calculations.mjs",
    "audit:module-integrations": "node scripts/audit-module-integrations.mjs",
    "ai:highlight": "node scripts/aiHighlight.js",
    "ai:highlight:force": "node scripts/aiHighlight.js --force",
    "audit:all-modules": "npm run audit:sales-hub && npm run audit:school-erp && npm run audit:retail-pos && npm run audit:restaurant-pos && npm run audit:property-erp && npm run audit:transport-rental && npm run audit:whatsapp-crm && npm run audit:module-integrations",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "worker:deploy": "wrangler deploy --config workers/nexora-email-api/wrangler.toml",
    "worker:secret": "wrangler secret put RESEND_API_KEY --config workers/nexora-email-api/wrangler.toml",
    "whatsapp:deploy": "wrangler deploy --config workers/nexora-whatsapp-api/wrangler.toml",
    "whatsapp:secret": "wrangler secret put META_APP_SECRET --config workers/nexora-whatsapp-api/wrangler.toml && wrangler secret put WHATSAPP_VERIFY_TOKEN --config workers/nexora-whatsapp-api/wrangler.toml",
    "passkeys:deploy": "wrangler deploy --config workers/nexora-passkeys-api/wrangler.toml",
    "passkeys:secret:email": "wrangler secret put FIREBASE_CLIENT_EMAIL --config workers/nexora-passkeys-api/wrangler.toml",
    "passkeys:secret:key": "wrangler secret put FIREBASE_PRIVATE_KEY --config workers/nexora-passkeys-api/wrangler.toml",
    "background-jobs:deploy": "wrangler deploy --config workers/nexora-background-jobs/wrangler.toml",
    "background-jobs:secret:email": "wrangler secret put FIREBASE_CLIENT_EMAIL --config workers/nexora-background-jobs/wrangler.toml",
    "background-jobs:secret:key": "wrangler secret put FIREBASE_PRIVATE_KEY --config workers/nexora-background-jobs/wrangler.toml",
    "background-jobs:secret:resend": "wrangler secret put RESEND_API_KEY --config workers/nexora-background-jobs/wrangler.toml"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.4",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "firebase": "^12.0.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.4",
    "vite": "8.0.13",
    "wrangler": "4.97.0"
  },
  "overrides": {
    "esbuild": "0.27.3"
  }
}
